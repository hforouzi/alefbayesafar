{% block flashs %}
    {% for message in app.flashes('primary') %}
        <!-- primary -->
        <div class="flex items-center p-3.5 rounded text-primary bg-primary-light dark:bg-primary-dark-light">
    <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.primary'|trans }}!</strong>{{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}
    <!-- secondary -->
    {% for message in app.flashes('secondary') %}
        
        <div class="flex items-center p-3.5 rounded text-secondary bg-secondary-light dark:bg-secondary-dark-light">
    <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.secondary'|trans }}!</strong>{{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <!-- success -->
        <div class="flex items-center p-3.5 rounded text-success bg-success-light dark:bg-success-dark-light">
    <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.success'|trans }}!</strong>{{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <!-- warning -->
        <div class="flex items-center p-3.5 rounded text-warning bg-warning-light dark:bg-warning-dark-light">
            <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.warning'|trans }}!</strong> {{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <!-- danger -->
        <div class="flex items-center p-3.5 rounded text-danger bg-danger-light dark:bg-danger-dark-light">
    <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.danger'|trans }}!</strong>{{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}
    {% for message in app.flashes('notice') %}
        <!-- info -->
        <div class="flex items-center p-3.5 rounded text-info bg-info-light dark:bg-info-dark-light">
    <span class="ltr:pr-2 rtl:pl-2"><strong class="ltr:mr-1 rtl:ml-1">{{ 'flash.info'|trans }}!</strong> {{ message|trans|raw }}</span>
            <button type="button" class="ltr:ml-auto rtl:mr-auto hover:opacity-80">
                <svg> ... </svg>
            </button>
        </div>
    {% endfor %}

{% endblock %}

