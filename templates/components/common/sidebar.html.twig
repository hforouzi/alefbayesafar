{% macro menu_links(links,category) %}
    
    
    {% import _self as macros %}
    {% for menuItem in links %}
        
        {% if menuItem.route != "#" and menuItem.category == category  %}
            {% if  menuItem.position =="1" %}
            <li class="menu nav-item">
                <a href="{{path(menuItem.route)}}" class="group">
                    <div class="flex items-center">
                        {{ ux_icon( menuItem.icon ,{class:"group-hover:!text-primary shrink-0"}) }}
                        <span
                                class="ltr:pl-3 rtl:pr-3 text-black dark:text-[#506690] dark:group-hover:text-white-dark">{{menuItem.name}}</span>
                    </div>
                </a>
            </li>
            {% else%}
                <li>
                    <a href="{{path(menuItem.route)}}">{{ menuItem.name }}</a>
                </li>
                {% endif %}
        {% endif %}
    
    {% endfor %}
{% endmacro %}
            
