{% set current_locale = app.request.locale|default('fa') %}
{% set text_direction = current_locale == 'fa' ? 'rtl' : 'ltr' %}
<!DOCTYPE html>
<html lang="{{ current_locale }}" dir="{{ text_direction }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}الفبای سفر{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon.svg') }}">
    <link rel="stylesheet" type="text/css" media="screen" href="{{ asset('assets/css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="min-h-screen overflow-x-hidden bg-[#f7f3ee] font-vazirmatn text-[#1f2933] antialiased">
    {% set nav = [
        { label: 'خانه', route: 'homepage' },
        { label: 'ساخت پکیج', route: 'public_build' },
        { label: 'پکیج‌های من', route: 'public_trips' }
    ] %}

    <div class="min-h-screen w-full max-w-full overflow-x-hidden">
        <header class="sticky top-0 z-40 border-b border-[#e7ddd0] bg-[#fffaf4]/90 backdrop-blur">
            <div class="mx-auto flex w-full max-w-6xl min-w-0 items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-6 lg:px-8">
                <a href="{{ path('homepage') }}" class="flex min-w-0 items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-[#0f766e] text-lg font-black text-white">ا</span>
                    <span class="min-w-0 leading-tight">
                        <span class="block truncate text-base font-extrabold text-[#18312f]">الفبای سفر</span>
                        <span class="hidden text-xs font-semibold text-[#6b716f] sm:block">سفرساز هوشمند فارسی</span>
                    </span>
                </a>

                <nav class="hidden shrink-0 items-center gap-1 md:flex" aria-label="ناوبری اصلی">
                    {% for item in nav %}
                        <a href="{{ path(item.route) }}" class="rounded-md px-4 py-2 text-sm font-bold transition {{ app.request.attributes.get('_route') == item.route ? 'bg-[#0f766e] text-white' : 'text-[#44514f] hover:bg-[#efe6db] hover:text-[#0f766e]' }}">
                            {{ item.label }}
                        </a>
                    {% endfor %}
                </nav>

                <div class="flex shrink-0 items-center gap-2">
                    {% if app.user %}
                        <a href="{{ path('app_profile_change_password') }}" class="hidden rounded-md border border-[#d8cab9] px-3 py-2 text-sm font-bold text-[#44514f] transition hover:border-[#0f766e] hover:text-[#0f766e] sm:inline-flex">پروفایل</a>
                        <a href="{{ path('app_logout') }}" class="rounded-md bg-[#18312f] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#0f766e]">خروج</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="rounded-md border border-[#d8cab9] px-3 py-2 text-sm font-bold text-[#44514f] transition hover:border-[#0f766e] hover:text-[#0f766e]">ورود</a>
                    {% endif %}
                </div>
            </div>
        </header>

        <main class="w-full max-w-full">
            {% block body %}{% endblock %}
        </main>

        <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-[#e7ddd0] bg-[#fffaf4]/95 px-2 py-2 shadow-lg backdrop-blur md:hidden" aria-label="ناوبری موبایل">
            <div class="mx-auto grid max-w-md grid-cols-4 gap-1 text-center">
                {% for item in nav %}
                    <a href="{{ path(item.route) }}" class="min-w-0 truncate rounded-md px-2 py-2 text-xs font-bold {{ app.request.attributes.get('_route') == item.route ? 'bg-[#0f766e] text-white' : 'text-[#596461]' }}">
                        {{ item.label }}
                    </a>
                {% endfor %}
                {% if app.user %}
                    <a href="{{ path('app_profile_change_password') }}" class="min-w-0 truncate rounded-md px-2 py-2 text-xs font-bold text-[#596461]">پروفایل</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="min-w-0 truncate rounded-md px-2 py-2 text-xs font-bold text-[#596461]">ورود</a>
                {% endif %}
            </div>
        </nav>

        <footer class="border-t border-[#e7ddd0] bg-[#fffaf4] pb-20 md:pb-0">
            <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-[#65716e] sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
                <p>الفبای سفر، پایه public برای برنامه‌ریزی سفر فارسی.</p>
                <p>نتایج، قیمت‌ها و موجودی در فازهای بعدی به منابع معتبر متصل می‌شوند.</p>
            </div>
        </footer>
    </div>

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>
