<header class="z-40 border-b border-white-light/40 bg-white/95 backdrop-blur dark:border-dark-light/20 dark:bg-[#0e1726]/95">
    <div class="relative flex min-h-[72px] w-full items-center px-5 py-2.5 sm:px-6">
        <div class="flex items-center gap-2">
            <button
                type="button"
                class="collapse-icon flex h-9 w-9 items-center justify-center rounded-full bg-white-light/40 text-dark transition hover:bg-white-light/90 dark:bg-dark/40 dark:text-white-dark dark:hover:bg-dark/60 lg:hidden"
                @click="$store.app.toggleSidebar()"
                aria-label="{{ 'layout.toggle_sidebar'|trans }}"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 7H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M20 12H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M20 17H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>

            <div class="hidden lg:block">
                <label class="relative block w-[380px] max-w-full">
                    <span class="sr-only">{{ 'layout.search'|trans }}</span>
                    <input
                        type="text"
                        class="form-input w-full rounded-full border-white-light bg-white-light/40 ltr:pl-11 rtl:pr-11 placeholder:text-white-dark dark:border-dark-light/20 dark:bg-dark/40"
                        placeholder="{{ 'layout.search'|trans }}"
                    >
                    <span class="pointer-events-none absolute inset-y-0 start-4 flex items-center text-white-dark">
                        <svg class="h-4.5 w-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="11.5" cy="11.5" r="9.5" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
                            <path d="M18.5 18.5L22 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </span>
                </label>
            </div>
        </div>

        <div class="flex items-center gap-2 ltr:ml-auto rtl:mr-auto">
            <button
                type="button"
                class="flex h-9 w-9 items-center justify-center rounded-full bg-white-light/40 text-dark transition hover:bg-white-light/90 dark:bg-dark/40 dark:text-white-dark dark:hover:bg-dark/60"
                @click="$store.app.toggleTheme($store.app.theme === 'light' ? 'dark' : ($store.app.theme === 'dark' ? 'system' : 'light'))"
                :aria-label="$store.app.theme === 'light' ? '{{ 'layout.dark_mode'|trans }}' : ($store.app.theme === 'dark' ? '{{ 'layout.theme'|trans }}' : '{{ 'layout.light_mode'|trans }}')"
                :title="$store.app.theme === 'light' ? '{{ 'layout.dark_mode'|trans }}' : ($store.app.theme === 'dark' ? '{{ 'layout.theme'|trans }}' : '{{ 'layout.light_mode'|trans }}')"
            >
                <svg x-cloak x-show="$store.app.theme === 'light'" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5" />
                    <path d="M12 2V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M12 20V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M4 12H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M22 12H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <svg x-cloak x-show="$store.app.theme === 'dark'" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21.0672 11.8568L20.4253 11.469L21.0672 11.8568ZM12.1432 2.93276L11.7553 2.29085V2.29085L12.1432 2.93276ZM21.25 12C21.25 17.1086 17.1086 21.25 12 21.25V22.75C17.9371 22.75 22.75 17.9371 22.75 12H21.25ZM12 21.25C6.89137 21.25 2.75 17.1086 2.75 12H1.25C1.25 17.9371 6.06294 22.75 12 22.75V21.25ZM2.75 12C2.75 6.89137 6.89137 2.75 12 2.75V1.25C6.06294 1.25 1.25 6.06294 1.25 12H2.75ZM15.5 14.25C12.3244 14.25 9.75 11.6756 9.75 8.5H8.25C8.25 12.5041 11.4959 15.75 15.5 15.75V14.25ZM20.4253 11.469C19.4172 13.1373 17.5882 14.25 15.5 14.25V15.75C18.1349 15.75 20.4407 14.3439 21.7092 12.2447L20.4253 11.469ZM9.75 8.5C9.75 6.41182 10.8627 4.5828 12.531 3.57467L11.7553 2.29085C9.65609 3.5593 8.25 5.86509 8.25 8.5H9.75ZM12 2.75C11.9115 2.75 11.8077 2.71008 11.7324 2.63168C11.6686 2.56527 11.6538 2.50244 11.6503 2.47703C11.6461 2.44587 11.6482 2.35557 11.7553 2.29085L12.531 3.57467C13.0342 3.27065 13.196 2.71398 13.1368 2.27627C13.0754 1.82126 12.7166 1.25 12 1.25V2.75ZM21.7092 12.2447C21.6444 12.3518 21.5541 12.3539 21.523 12.3497C21.4976 12.3462 21.4347 12.3314 21.3683 12.2676C21.2899 12.1923 21.25 12.0885 21.25 12H22.75C22.75 11.2834 22.1787 10.9246 21.7237 10.8632C21.286 10.804 20.7293 10.9658 20.4253 11.469L21.7092 12.2447Z" fill="currentColor" />
                </svg>
                <svg x-cloak x-show="$store.app.theme === 'system'" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 9C3 6.17157 3 4.75736 3.87868 3.87868C4.75736 3 6.17157 3 9 3H15C17.8284 3 19.2426 3 20.1213 3.87868C21 4.75736 21 6.17157 21 9V14C21 15.8856 21 16.8284 20.4142 17.4142C19.8284 18 18.8856 18 17 18H7C5.11438 18 4.17157 18 3.58579 17.4142C3 16.8284 3 15.8856 3 14V9Z" stroke="currentColor" stroke-width="1.5" />
                    <path opacity="0.5" d="M22 21H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path opacity="0.5" d="M15 15H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>

            <div class="dropdown relative" x-data="dropdown" @click.outside="open = false">
                <button
                    type="button"
                    class="flex items-center gap-2 rounded-full bg-white-light/40 px-2.5 py-2 text-sm font-semibold text-dark transition hover:bg-white-light/90 dark:bg-dark/40 dark:text-white-dark dark:hover:bg-dark/60"
                    @click="toggle"
                    aria-label="{{ 'layout.language'|trans }}"
                >
                    <img class="h-5 w-5 rounded-full object-cover" src="{{ asset('assets/images/flags/' ~ (app.request.locale|lower == 'de' ? 'DE' : 'EN') ~ '.svg') }}" alt="{{ app.request.locale|upper }}">
                    <span class="hidden sm:inline uppercase">{{ app.request.locale }}</span>
                </button>
                <div x-cloak x-show="open" x-transition class="absolute right-0 top-11 z-50 w-56 rounded-2xl border border-white-light/40 bg-white p-2 shadow-[0_2px_2px_rgb(224_230_237_/_46%),_1px_6px_7px_rgb(224_230_237_/_46%)] dark:border-dark-light/20 dark:bg-[#0e1726]">
                    <div class="px-3 py-2 text-xs font-bold uppercase tracking-[0.2em] text-white-dark">{{ 'layout.language'|trans }}</div>
                    <a href="{{ path('app_locale_switch', { locale: 'de' }) }}" class="flex items-center gap-3 rounded-xl px-3 py-2 hover:bg-primary/10 hover:text-primary">
                        <img class="h-5 w-5 rounded-full object-cover" src="{{ asset('assets/images/flags/DE.svg') }}" alt="Deutsch">
                        <span>{{ 'language.german'|trans }}</span>
                    </a>
                    <a href="{{ path('app_locale_switch', { locale: 'en' }) }}" class="flex items-center gap-3 rounded-xl px-3 py-2 hover:bg-primary/10 hover:text-primary">
                        <img class="h-5 w-5 rounded-full object-cover" src="{{ asset('assets/images/flags/EN.svg') }}" alt="English">
                        <span>{{ 'language.english'|trans }}</span>
                    </a>
                </div>
            </div>

            <div class="dropdown relative" x-data="dropdown" @click.outside="open = false">
                <button
                    type="button"
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-white-light/40 text-dark transition hover:bg-white-light/90 dark:bg-dark/40 dark:text-white-dark dark:hover:bg-dark/60"
                    @click="toggle"
                    aria-label="{{ 'layout.notifications'|trans }}"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.5" d="M12 22a2.25 2.25 0 0 0 2.245-2.002H9.755A2.25 2.25 0 0 0 12 22Z" fill="currentColor" />
                        <path d="M19.5 16.5H4.5c1.105 0 2-.895 2-2v-4.25C6.5 6.796 8.796 4.5 11.75 4.5h.5c2.954 0 5.25 2.296 5.25 5.25v4.75c0 1.105.895 2 2 2Z" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                </button>
                <div x-cloak x-show="open" x-transition class="absolute right-0 top-11 z-50 w-72 rounded-2xl border border-white-light/40 bg-white p-4 shadow-[0_2px_2px_rgb(224_230_237_/_46%),_1px_6px_7px_rgb(224_230_237_/_46%)] dark:border-dark-light/20 dark:bg-[#0e1726]">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm font-semibold text-black dark:text-white-light">{{ 'layout.notifications'|trans }}</div>
                            <div class="text-xs text-white-dark">{{ 'dashboard.placeholder.no_data'|trans }}</div>
                        </div>
                        <span class="rounded-full bg-info/10 px-2.5 py-1 text-xs font-semibold text-info">0</span>
                    </div>
                </div>
            </div>

            <div class="dropdown relative" x-data="dropdown" @click.outside="open = false">
                <button
                    type="button"
                    class="flex items-center gap-2 rounded-full bg-white-light/40 px-2 py-2 text-sm font-semibold text-dark transition hover:bg-white-light/90 dark:bg-dark/40 dark:text-white-dark dark:hover:bg-dark/60"
                    @click="toggle"
                >
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-white">
                        {{ app.user ? app.user.userIdentifier|slice(0, 1)|upper : 'U' }}
                    </span>
                    <span class="hidden sm:block text-left leading-4">
                        <span class="block text-xs text-white-dark">{{ 'layout.account'|trans }}</span>
                        <span class="block max-w-[10rem] truncate font-semibold text-dark dark:text-white-light">
                            {{ app.user ? app.user.userIdentifier : '-' }}
                        </span>
                    </span>
                </button>
                <div x-cloak x-show="open" x-transition class="absolute right-0 top-11 z-50 w-72 rounded-2xl border border-white-light/40 bg-white p-2 shadow-[0_2px_2px_rgb(224_230_237_/_46%),_1px_6px_7px_rgb(224_230_237_/_46%)] dark:border-dark-light/20 dark:bg-[#0e1726]">
                    <div class="px-3 py-2">
                        <div class="font-semibold text-black dark:text-white-light">
                            {{ app.user ? app.user.userIdentifier : '-' }}
                        </div>
                        <div class="text-xs text-white-dark">{{ 'layout.view_profile'|trans }}</div>
                    </div>
                    <div class="my-2 border-t border-white-light/40 dark:border-dark-light/20"></div>
                    <a href="#" class="flex items-center gap-3 rounded-xl px-3 py-2 hover:bg-primary/10 hover:text-primary">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-info/10 text-info">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 12.75a4.5 4.5 0 1 0-4.5-4.5 4.5 4.5 0 0 0 4.5 4.5Z" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 20.25c1.7-3 4.55-4.5 7.5-4.5s5.8 1.5 7.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                        </span>
                        <span>{{ 'layout.view_profile'|trans }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-3 rounded-xl px-3 py-2 hover:bg-danger/10 hover:text-danger">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-danger/10 text-danger">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M16 17.75V19a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19V5A2.25 2.25 0 0 1 6.75 2.75h7A2.25 2.25 0 0 1 16 5v1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M20 12H9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M17.5 9.5 20 12l-2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </span>
                        <span>{{ 'layout.logout'|trans }}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
