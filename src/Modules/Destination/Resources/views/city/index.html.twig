{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'destination.city.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'destination.city.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('destination_city_new') }}" class="btn btn-primary">{{ 'destination.city.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% set table_body %}
        <thead>
            <tr>
                <th>{{ 'destination.city.name'|trans }}</th>
                <th>{{ 'destination.city.name_fa'|trans }}</th>
                <th>{{ 'destination.city.country'|trans }}</th>
                <th>{{ 'destination.common.active'|trans }}</th>
                <th class="text-right">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for city in cities %}
                <tr>
                    <td class="font-semibold text-black dark:text-white-light">{{ city.name }}</td>
                    <td>{{ city.nameFa ?: '-' }}</td>
                    <td>{{ city.country }}</td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: city.active ? 'active' : 'inactive',
                            label: city.active ? 'destination.common.active' : 'destination.common.inactive',
                        } %}
                    </td>
                    <td class="whitespace-nowrap text-right">
                        <div class="flex flex-wrap justify-end gap-2">
                            <a href="{{ path('destination_city_edit', { id: city.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('destination_city_delete', { id: city.id }) }}" onsubmit="return confirm('{{ 'destination.common.delete_confirmation'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_destination_city_' ~ city.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-10 text-center text-white-dark">{{ 'destination.city.empty'|trans }}</td></tr>
            {% endfor %}
        </tbody>
    {% endset %}
    {% include 'components/_card.html.twig' with { body: include('components/_table.html.twig', { body: table_body }) } %}
{% endblock %}
