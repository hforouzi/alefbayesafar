{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'destination.district.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'destination.district.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('destination_district_new') }}" class="btn btn-primary">{{ 'destination.district.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@Destination/admin/_table_filters.html.twig' with { table: 'districts' } %}

    {% set table_body %}
        <thead>
            <tr>
                <th>{{ 'destination.district.name'|trans }}</th>
                <th>{{ 'destination.district.name_fa'|trans }}</th>
                <th>{{ 'destination.district.city'|trans }}</th>
                <th>{{ 'destination.city.country'|trans }}</th>
                <th>{{ 'destination.common.active'|trans }}</th>
                <th class="text-right">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for district in districts %}
                <tr>
                    <td class="font-semibold text-black dark:text-white-light">{{ district.name }}</td>
                    <td>{{ district.nameFa ?: '-' }}</td>
                    <td>{{ district.city.name }}</td>
                    <td>{{ district.city.country }}</td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: district.active ? 'active' : 'inactive',
                            label: district.active ? 'destination.common.active' : 'destination.common.inactive',
                        } %}
                    </td>
                    <td class="whitespace-nowrap text-right">
                        <div class="flex flex-wrap justify-end gap-2">
                            <a href="{{ path('destination_district_edit', { id: district.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('destination_district_delete', { id: district.id }) }}" onsubmit="return confirm('{{ 'destination.common.delete_confirmation'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_destination_district_' ~ district.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="py-10 text-center text-white-dark"><div>{{ 'destination.datatable.no_results'|trans }}</div><a href="{{ path('destination_district_index') }}" class="mt-3 inline-flex text-primary hover:underline">{{ 'destination.datatable.reset_filters'|trans }}</a></td></tr>
            {% endfor %}
        </tbody>
    {% endset %}
    {% include 'components/_card.html.twig' with { body: include('components/_table.html.twig', { body: table_body }) } %}
    {% include '@Destination/admin/_pagination.html.twig' %}
{% endblock %}
