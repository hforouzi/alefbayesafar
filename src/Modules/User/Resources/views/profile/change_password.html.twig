{% extends "components/layout/default.html.twig" %}

{% block content %}
    <div class="flex flex-col gap-6">
        <!-- Page title -->
        <div class="flex items-center justify-between">
            <h4 class="text-lg font-semibold text-slate-700 dark:text-slate-200">
                {{ 'Profile.change_password'|trans }}
            </h4>
        </div>
        
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
            <div class="card">
                <div class="card-body space-y-4">
                    
                    {# Flash messages #}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger">{{ message }}</div>
                    {% endfor %}
                    
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">{{ message }}</div>
                    {% endfor %}
                    
                    {{ form_start(form, {attr: {class: "space-y-4"}}) }}
                    
                    <div>
                        {{ form_label(form.currentPassword, null, {label_attr: {class: "block text-sm font-medium text-slate-600 dark:text-slate-300"}}) }}
                        {{ form_widget(form.currentPassword, {
                            attr: {
                                class: "form-input mt-1 block w-full"
                            }
                        }) }}
                        <p class="text-red-500 text-xs mt-1">{{ form_errors(form.currentPassword) }}</p>
                    </div>
                    
                    <div>
                        {{ form_label(form.newPassword.first, null, {label_attr: {class: "block text-sm font-medium text-slate-600 dark:text-slate-300"}}) }}
                        {{ form_widget(form.newPassword.first, {
                            attr: {
                                class: "form-input mt-1 block w-full"
                            }
                        }) }}
                        <p class="text-red-500 text-xs mt-1">{{ form_errors(form.newPassword.first) }}</p>
                    </div>
                    
                    <div>
                        {{ form_label(form.newPassword.second, null, {label_attr: {class: "block text-sm font-medium text-slate-600 dark:text-slate-300"}}) }}
                        {{ form_widget(form.newPassword.second, {
                            attr: {
                                class: "form-input mt-1 block w-full"
                            }
                        }) }}
                        <p class="text-red-500 text-xs mt-1">{{ form_errors(form.newPassword.second) }}</p>
                    </div>
                    
                    <div class="pt-4">
                        <button type="submit" class="btn btn-primary w-full sm:w-auto">
                            {{ 'Change Password'|trans }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
