{{ include('partials/main.html.twig') }}

<head>

    {{ include('partials/title-meta.html.twig', {title: 'Sign In'}) }}

    {{ include('partials/head-css.html.twig') }}

</head>

<body class="bg-white">

<div class="auth-page d-flex align-items-center min-vh-100">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-xxl-3 col-lg-4 col-md-5">
                <div class="d-flex flex-column h-100 py-5 px-4">
                    <div class="text-center text-muted mb-2">
                        <div class="pb-3">
                            <a href="/">
                                            <span class="logo-lg">
                                            <img src="{{ asset('images/logo.png') }}">
                                            </span>
                            </a>
                        </div>
                    </div>

                    <div class="my-auto">
                        <div class="p-3 text-center">
                            <img src="/images/auth-img.png" alt="" class="img-fluid">
                        </div>
                    </div>

                    <div class="mt-4 mt-md-5 text-center">
                        <p class="mb-0">© <script>document.write(new Date().getFullYear())</script> WMS <i class="mdi mdi-heart text-danger"></i></p>
                    </div>
                </div>

                <!-- end auth full page content -->
            </div>
            <!-- end col -->

            <div class="col-xxl-9 col-lg-8 col-md-7">
                <div class="auth-bg bg-light py-md-5 p-4 d-flex">
                    <div class="bg-overlay-gradient"></div>
                    <!-- end bubble effect -->
                    <div class="row justify-content-center g-0 align-items-center w-100">
                        <div class="col-xl-4 col-lg-8">
                            <div class="card">
                                <div class="card-body">
                                    <div class="px-3 py-3">
                                        <div class="text-center">
                                            <h5 class="mb-0">Willkommen zurück !</h5>
                                            <p class="text-muted mt-2">Bitte anmelden</p>
                                        </div>
                                        <form method="POST" class="mt-4 pt-2">
                                            <div class="form-floating form-floating-custom mb-3">
                                                
                                                <input type="email" value="{{ last_username }}"  class="form-control"  id="inputEmail" name="email" id="email" placeholder="Enter User Name" required autofocus>
                                                <label for="input-username">Username</label>
                                                <div class="form-floating-icon">
                                                    <i class="uil uil-users-alt"></i>
                                                </div>
                                            </div>
                                            <div class="form-floating form-floating-custom mb-3 auth-pass-inputgroup">
                                               
                                                <input type="password" class="form-control" name="password" id="inputPassword" placeholder="Enter Password" required autocomplete="current-password" >
                                                <button type="button" class="btn btn-link position-absolute h-100 end-0 top-0" id="password-addon">
                                                    <i class="mdi mdi-eye-outline font-size-18 text-muted"></i>
                                                </button>
                                                <label for="password-input">Password</label>
                                                <div class="form-floating-icon">
                                                    <i class="uil uil-padlock"></i>
                                                </div>
                                            </div>
                                            <div class="form-check form-check-primary font-size-16 py-1">
                                                <input class="form-check-input" type="checkbox" id="remember-check">

                                                <label class="form-check-label font-size-14" for="remember-check">
                                                    Remember me
                                                </label>
                                            </div>
                                            <input type="hidden" name="_csrf_token"
                                                   value="{{ csrf_token('authenticate') }}"
                                            >
                                            {# Hidden input to store the reCAPTCHA token #}
                                            <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">
                                            
                                            <div class="mt-3">
                                                <button class="btn btn-primary w-100" type="submit">Einloggen</button>
                                            </div>
                                        </form><!-- end form -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end col -->
        </div>
        <!-- end row -->
    </div>
    <!-- end container fluid -->
</div>
<!-- end authentication section -->

{{ include('partials/vendor-scripts.html.twig') }}

<script src="/js/pages/pass-addon.init.js"></script>
<script src="https://www.google.com/recaptcha/api.js?render=6Lf4vFEqAAAAABp0myl5uZ6jSCekDOlq3LRsQ6k6"></script>
<script>
    grecaptcha.ready(function () {
        grecaptcha.execute('6Lf4vFEqAAAAABp0myl5uZ6jSCekDOlq3LRsQ6k6', { action: 'submit' }).then(function (token) {
            document.getElementById('g-recaptcha-response').value = token;
        });
    });
</script>
</body>
</html>
