{% set submitLabel = submit_label|default('permission.save'|trans) %}
{% set pageTitle = page_title|default(new|default(false) ? 'permission.new'|trans : 'permission.edit'|trans) %}

<div class="animate__animated p-6" :class="[$store.app.animation]" x-data="permissionForm()">
    <ul class="mb-5 flex space-x-2 rtl:space-x-reverse">
        <li>
            <a href="{{ path('permission_list') }}" class="text-primary hover:underline">{{ 'permission.title'|trans }}</a>
        </li>
        <li class="before:content-['/'] ltr:before:mr-2 rtl:before:ml-2">
            <span>{{ pageTitle }}</span>
        </li>
    </ul>

    <div class="panel">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h5 class="text-lg font-semibold dark:text-white-light">{{ pageTitle }}</h5>
                <p class="mt-1 text-sm text-white-dark">{{ 'permission.help.controller_actions'|trans }}</p>
            </div>
            <a href="{{ path('sync_actions') }}" class="btn btn-primary">
                <svg class="h-5 w-5 ltr:mr-2 rtl:ml-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 12C4 16.4183 7.58172 20 12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C9.25022 4 6.82447 5.38734 5.38451 7.50024" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M7 7.99999H5C4.44772 7.99999 4 7.55228 4 6.99999V5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ 'permissions.sync'|trans }}
            </a>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            {% if form.vars.errors|length > 0 %}
                <div class="rounded-md border border-danger bg-danger/10 p-4 text-danger">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'mb-2 block font-semibold text-dark dark:text-white-light'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-input'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div>
                    {{ form_label(form.route, null, {'label_attr': {'class': 'mb-2 block font-semibold text-dark dark:text-white-light'}}) }}
                    {{ form_widget(form.route, {'attr': {'class': 'form-input'}}) }}
                    {% if form.route.vars.help %}
                        <p class="mt-1 text-xs text-white-dark">{{ form.route.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.route) }}
                </div>
            </div>

            <div class="rounded border border-[#ebedf2] dark:border-[#1b2e4b]">
                <div class="border-b border-[#ebedf2] p-4 dark:border-[#1b2e4b]">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <h6 class="font-semibold text-dark dark:text-white-light">{{ 'permission.controller_actions'|trans }}</h6>
                            <p class="mt-1 text-xs text-white-dark">{{ form.controllerActions.vars.help|default('permission.help.controller_actions'|trans) }}</p>
                        </div>
                        <div class="flex flex-col gap-2 sm:flex-row">
                            <input type="text" class="form-input w-full sm:w-64" placeholder="{{ 'actions.search'|trans }}..." x-model="searchText">
                            <button type="button" class="btn btn-outline-primary btn-sm" @click="selectAll()">{{ 'actions.select_all'|trans }}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @click="deselectAll()">{{ 'actions.deselect_all'|trans }}</button>
                        </div>
                    </div>
                </div>

                <div class="space-y-3 p-4" x-data="{ active: '{{ groupedActions|keys|first|default('') }}' }">
                    {% for module, controllers in groupedActions %}
                        <div class="overflow-hidden rounded border border-[#d3d3d3] dark:border-[#1b2e4b]">
                            <button type="button"
                                    class="flex w-full items-center bg-[#f7f7f7] p-4 font-semibold text-white-dark hover:text-primary dark:bg-[#1b2e4b]"
                                    :class="{'!text-primary': active === '{{ module|e('js') }}'}"
                                    @click="active === '{{ module|e('js') }}' ? active = null : active = '{{ module|e('js') }}'">
                                <span>{{ 'module'|trans }} {{ module }}</span>
                                <span class="badge rounded-full bg-primary/10 text-primary ltr:ml-3 rtl:mr-3">{{ controllers|length }}</span>
                                <span class="ltr:ml-auto rtl:mr-auto" :class="{'rotate-180': active === '{{ module|e('js') }}'}">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M19 9L12 15L5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                            </button>

                            <div x-show="active === '{{ module|e('js') }}'" x-collapse>
                                <div class="space-y-4 border-t border-[#d3d3d3] p-4 dark:border-[#1b2e4b]">
                                    {% for controllerName, actions in controllers %}
                                        <div class="rounded-md bg-secondary/5 p-4 dark:bg-secondary/10" x-show="matches('{{ controllerName|lower|e('js') }}')">
                                            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                                <div>
                                                    <h6 class="font-semibold text-secondary">{{ controllerName }}Controller</h6>
                                                    <p class="text-xs text-white-dark">{{ actions|length }} {{ 'action'|trans }}</p>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        @click="selectControllerActions('{{ module|e('js') }}', '{{ controllerName|e('js') }}')">
                                                    {{ 'actions.select_all'|trans }}
                                                </button>
                                            </div>

                                            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
                                                {% for action in actions %}
                                                    <label class="flex cursor-pointer items-start gap-3 rounded-md border border-white-light/60 bg-white p-3 transition hover:border-primary hover:bg-primary/5 dark:border-[#1b2e4b] dark:bg-[#0e1726]"
                                                           x-show="matches('{{ action.action|lower|e('js') }}')"
                                                           data-module="{{ module }}"
                                                           data-controller="{{ controllerName }}">
                                                        {% for checkbox in form.controllerActions %}
                                                            {% if checkbox.vars.value == action.id %}
                                                                {{ form_widget(checkbox, {'attr': {'class': 'form-checkbox text-primary controller-checkbox mt-1', '@change': 'updateCount()'}}) }}
                                                            {% endif %}
                                                        {% endfor %}
                                                        <span>
                                                            <span class="block font-semibold text-dark dark:text-white-light">{{ action.action }}</span>
                                                            <span class="block text-xs text-white-dark">{{ action.controllerName }}::{{ action.action }}</span>
                                                        </span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="rounded-md border border-warning bg-warning/10 p-4 text-warning">
                            {{ 'permissions.no_actions'|trans }}
                        </div>
                    {% endfor %}

                    {{ form_errors(form.controllerActions) }}
                </div>
            </div>

            <div class="rounded-md bg-success/10 p-4">
                <div class="flex items-center justify-between">
                    <span class="font-semibold text-success">{{ 'selected_actions_count'|trans }}</span>
                    <span class="badge bg-success text-white" x-text="selectedCount">0</span>
                </div>
            </div>

            <div class="flex flex-col-reverse gap-3 border-t border-[#ebedf2] pt-5 dark:border-[#1b2e4b] sm:flex-row sm:items-center sm:justify-end">
                <a href="{{ path('permission_list') }}" class="btn btn-outline-danger">{{ 'permission.cancel'|trans }}</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="h-5 w-5 ltr:mr-2 rtl:ml-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 12L10.5 15L16.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ submitLabel }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
    function permissionForm() {
        return {
            searchText: '',
            selectedCount: 0,
            init() {
                this.updateCount();
            },
            matches(value) {
                if (this.searchText === '') return true;
                return value.includes(this.searchText.toLowerCase());
            },
            selectAll() {
                document.querySelectorAll('.controller-checkbox').forEach((checkbox) => {
                    checkbox.checked = true;
                });
                this.updateCount();
            },
            selectControllerActions(module, controller) {
                document.querySelectorAll(`[data-module="${module}"][data-controller="${controller}"] .controller-checkbox`).forEach((checkbox) => {
                    checkbox.checked = true;
                });
                this.updateCount();
            },
            deselectAll() {
                document.querySelectorAll('.controller-checkbox').forEach((checkbox) => {
                    checkbox.checked = false;
                });
                this.updateCount();
            },
            updateCount() {
                this.selectedCount = document.querySelectorAll('.controller-checkbox:checked').length;
            }
        }
    }
</script>
