{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'search_source.source.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'search_source.source.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('search_source_new') }}" class="btn btn-primary">{{ 'search_source.source.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@SearchSource/admin/_table_filters.html.twig' %}

    {% set table_body %}
        <thead>
            <tr>
                <th>{{ 'search_source.source.name'|trans }}</th>
                <th>{{ 'search_source.source.domain'|trans }}</th>
                <th>{{ 'search_source.source.provider'|trans }}</th>
                <th>{{ 'search_source.source.provider_type'|trans }}</th>
                <th>{{ 'search_source.source.country'|trans }}</th>
                <th>{{ 'search_source.source.language'|trans }}</th>
                <th>{{ 'search_source.source.capabilities'|trans }}</th>
                <th>{{ 'search_source.source.priority'|trans }}</th>
                <th>{{ 'search_source.common.enabled'|trans }}</th>
                <th class="text-right">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for source in sources %}
                <tr>
                    <td class="font-semibold text-black dark:text-white-light">
                        <a href="{{ path('search_source_show', { id: source.id }) }}" class="hover:text-primary">{{ source.name }}</a>
                    </td>
                    <td>{{ source.domain }}</td>
                    <td>{{ source.provider }}</td>
                    <td>{{ ('search_source.provider_type.' ~ source.providerType.value|lower)|trans }}</td>
                    <td>{{ source.country ?: '-' }}</td>
                    <td>{{ source.language ?: '-' }}</td>
                    <td>
                        <div class="flex flex-wrap gap-1">
                            {% for capability in source.capabilities %}
                                <span class="badge badge-outline-primary">{{ ('search_source.capability.' ~ capability)|trans }}</span>
                            {% else %}
                                <span class="text-white-dark">-</span>
                            {% endfor %}
                        </div>
                    </td>
                    <td>{{ source.priority }}</td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: source.enabled ? 'active' : 'inactive',
                            label: source.enabled ? 'search_source.common.enabled' : 'search_source.common.disabled',
                        } %}
                    </td>
                    <td class="whitespace-nowrap text-right">
                        <div class="flex flex-wrap justify-end gap-2">
                            <a href="{{ path('search_source_show', { id: source.id }) }}" class="btn btn-sm btn-outline-secondary">{{ 'common.show'|trans }}</a>
                            <a href="{{ path('search_source_edit', { id: source.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('search_source_delete', { id: source.id }) }}" onsubmit="return confirm('{{ (source.enabled ? 'search_source.common.disable_confirmation' : 'search_source.common.enable_confirmation')|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_search_source_' ~ source.id) }}">
                                <button type="submit" class="btn btn-sm {{ source.enabled ? 'btn-outline-danger' : 'btn-outline-success' }}">{{ (source.enabled ? 'search_source.common.disable' : 'search_source.common.enable')|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="10" class="py-10 text-center text-white-dark"><div>{{ 'search_source.datatable.no_results'|trans }}</div><a href="{{ path('search_source_index') }}" class="mt-3 inline-flex text-primary hover:underline">{{ 'search_source.datatable.reset_filters'|trans }}</a></td></tr>
            {% endfor %}
        </tbody>
    {% endset %}
    {% include 'components/_card.html.twig' with { body: include('components/_table.html.twig', { body: table_body }) } %}
    {% include '@SearchSource/admin/_pagination.html.twig' %}
{% endblock %}
