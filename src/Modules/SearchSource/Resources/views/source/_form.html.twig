{{ form_start(form, { attr: { class: 'space-y-8' } }) }}
    {{ form_errors(form) }}

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'search_source.sections.identity'|trans }}</h3>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
            {% for field in [form.name, form.domain, form.provider, form.providerType, form.language, form.priority] %}
                <div>
                    {{ form_label(field, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
                    {{ form_widget(field) }}
                    {{ form_help(field) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'search_source.sections.scope'|trans }}</h3>
        <div
            class="relative"
            data-controller="geo-select"
            data-geo-select-url-value="{{ path('destination_lookup_countries') }}"
            data-geo-select-min-length-value="1"
            data-loading-text="{{ 'search_source.lookup.loading'|trans }}"
            data-no-results-text="{{ 'search_source.lookup.no_results'|trans }}"
            data-error-text="{{ 'search_source.lookup.error'|trans }}"
        >
            <label class="mb-2 block text-sm font-medium text-black dark:text-white-light" for="{{ form.countryId.vars.id }}_search">{{ form.countryId.vars.label|trans }}</label>
            <div class="flex gap-2">
                <input id="{{ form.countryId.vars.id }}_search" type="search" class="form-input" value="{{ source.country ? source.country : '' }}" placeholder="{{ 'search_source.lookup.country_placeholder'|trans }}" data-geo-select-target="input" data-action="input->geo-select#search keydown->geo-select#keydown" autocomplete="off">
                <button type="button" class="btn btn-outline-danger shrink-0" data-action="geo-select#clear">{{ 'search_source.lookup.clear'|trans }}</button>
            </div>
            {{ form_widget(form.countryId, { value: source.country ? source.country.id : '', attr: { 'data-geo-select-target': 'hidden' } }) }}
            <div class="mt-1 text-xs text-gray-500" data-geo-select-target="status"></div>
            <div class="absolute z-20 mt-1 hidden max-h-60 w-full overflow-auto rounded-md border border-white-light bg-white shadow-lg dark:border-dark-light/20 dark:bg-[#0e1726]" data-geo-select-target="results"></div>
            {{ form_errors(form.countryId) }}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'search_source.sections.capabilities'|trans }}</h3>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
            {% for choice in form.capabilities %}
                <label class="inline-flex items-center gap-3 rounded border border-white-light/60 bg-white px-3 py-2 dark:border-dark-light/20 dark:bg-[#0e1726]">
                    {{ form_widget(choice) }}
                    <span>{{ choice.vars.label|trans }}</span>
                </label>
            {% endfor %}
        </div>
        {{ form_errors(form.capabilities) }}
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'search_source.sections.config'|trans }}</h3>
        <div>
            {{ form_label(form.configJson, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
            {{ form_widget(form.configJson) }}
            <div class="mt-2 text-xs text-white-dark">{{ form_help(form.configJson) }}</div>
            {{ form_errors(form.configJson) }}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'search_source.sections.status'|trans }}</h3>
        <label class="inline-flex items-center gap-3 rounded-2xl border border-white-light/40 bg-white px-4 py-4 text-sm font-medium text-black dark:border-dark-light/20 dark:bg-[#0e1726] dark:text-white-light">
            {{ form_widget(form.enabled) }}
            <span>{{ form.enabled.vars.label|trans }}</span>
        </label>
        {{ form_errors(form.enabled) }}
    </section>

    <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
        <a href="{{ source.id ? path('search_source_show', { id: source.id }) : path('search_source_index') }}" class="btn btn-light">{{ 'common.cancel'|trans }}</a>
    </div>
    {{ form_rest(form) }}
{{ form_end(form, { render_rest: false }) }}
