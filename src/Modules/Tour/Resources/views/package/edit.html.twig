{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'tour.package.edit'|trans }}{% endblock %}
{% block page_subtitle %}{{ package.name }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('tour_package_index') }}" class="btn btn-outline-secondary">{{ 'tour.package.back_to_list'|trans }}</a>
{% endblock %}

{% block body %}
    <div class="space-y-6">
        {% include 'components/_card.html.twig' with { body: include('@Tour/package/_form.html.twig', { form: form, package: package }) } %}
        {% include 'components/_card.html.twig' with { body: include('@Tour/image/_grid.html.twig', { package: package }) } %}
    </div>
{% endblock %}
