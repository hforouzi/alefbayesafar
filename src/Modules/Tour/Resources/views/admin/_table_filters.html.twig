{% macro text_filter(name, label, value) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</span>
        <input type="text" name="{{ name }}" value="{{ value|default('') }}" class="form-input form-input-sm" autocomplete="off">
    </label>
{% endmacro %}

{% macro boolean_filter(name, label, value) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</span>
        <select name="{{ name }}" class="form-select form-select-sm">
            <option value="">{{ 'tour.datatable.all'|trans }}</option>
            <option value="1" {{ value|default('') == '1' ? 'selected' : '' }}>{{ 'tour.common.yes'|trans }}</option>
            <option value="0" {{ value|default('') == '0' ? 'selected' : '' }}>{{ 'tour.common.no'|trans }}</option>
        </select>
    </label>
{% endmacro %}

{% import _self as controls %}

{% set filters = pagination.filters %}

<form method="get" class="mb-4 rounded border border-white-light/60 p-4 dark:border-dark-light/20">
    <div class="grid gap-3 md:grid-cols-5">
        {{ controls.text_filter('q', 'tour.datatable.search'|trans, filters.q|default('')) }}
        {{ controls.text_filter('destination', 'tour.package.destination'|trans, filters.destination|default('')) }}
        {{ controls.boolean_filter('active', 'tour.package.active'|trans, filters.active|default('')) }}
        {{ controls.boolean_filter('featured', 'tour.package.featured'|trans, filters.featured|default('')) }}
        {{ controls.boolean_filter('publicVisible', 'tour.package.public_visible'|trans, filters.publicVisible|default('')) }}
    </div>

    <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
        <label class="block">
            <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'tour.datatable.rows_per_page'|trans }}</span>
            <select name="pageSize" class="form-select form-select-sm w-28">
                {% for size in [25, 50, 100] %}
                    <option value="{{ size }}" {{ pagination.pageSize == size ? 'selected' : '' }}>{{ size }}</option>
                {% endfor %}
            </select>
        </label>

        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">{{ 'tour.datatable.filter'|trans }}</button>
            <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})) }}" class="btn btn-outline-secondary">{{ 'tour.datatable.reset_filters'|trans }}</a>
        </div>
    </div>
</form>
