{% extends 'layouts/admin.html.twig' %}

{% macro lookup_field(formField, label, url, value, selectedLabel, placeholder) %}
    <div
        data-controller="geo-select"
        data-geo-select-url-value="{{ url }}"
        data-loading-text="{{ 'tour.lookup.loading'|trans }}"
        data-no-results-text="{{ 'tour.lookup.no_results'|trans }}"
        data-error-text="{{ 'tour.lookup.error'|trans }}"
        class="relative"
    >
        <label for="{{ formField.vars.id }}_search" class="form-label">{{ label|trans }}</label>
        <div class="flex gap-2">
            <input id="{{ formField.vars.id }}_search" type="search" value="{{ selectedLabel|default('') }}" placeholder="{{ placeholder|trans }}" autocomplete="off" class="form-input" data-geo-select-target="input" data-action="input->geo-select#search keydown->geo-select#keydown">
            <button type="button" class="btn btn-outline-secondary px-3" data-action="geo-select#clear">{{ 'tour.lookup.clear'|trans }}</button>
        </div>
        {{ form_widget(formField, { value: value|default(''), attr: { 'data-geo-select-target': 'hidden' } }) }}
        <div class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-auto rounded border border-white-light bg-white shadow-lg dark:border-dark-light/20 dark:bg-[#0e1726]" data-geo-select-target="results"></div>
        <div class="mt-1 min-h-4 text-xs text-danger">{{ form_errors(formField) }}</div>
        <div class="mt-1 min-h-4 text-xs text-white-dark" data-geo-select-target="status"></div>
    </div>
{% endmacro %}

{% import _self as controls %}

{% block page_title %}{{ 'tour.external_test.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'tour.external_test.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('tour_package_index') }}" class="btn btn-outline-secondary">{{ 'tour.package.title'|trans }}</a>
{% endblock %}

{% block body %}
    {% if not hasSources %}
        <div class="mb-5 rounded border border-warning/30 bg-warning/10 px-4 py-3 text-warning">
            {{ 'tour.external_test.no_sources'|trans }}
        </div>
    {% endif %}

    {% if submitted %}
        <div id="external-tour-search-summary" tabindex="-1" class="rounded border border-info/30 bg-info/10 px-4 py-3 text-info outline-none ring-0">
            <div class="font-semibold">{{ ('tour.external_test.summary_state.' ~ searchState|default('invalid_request'))|trans }}</div>
            <div class="mt-1 text-sm">{{ ('tour.external_test.summary_help.' ~ searchState|default('invalid_request'))|trans }}</div>
            {% if summary %}
                <div class="mt-2 text-sm">
                    {{ 'tour.external_test.sources_considered'|trans }}: {{ summary.results|length }}
                    <span class="mx-2">|</span>
                    {{ 'tour.external_test.accepted'|trans }}: {{ summary.candidates|length }}
                    <span class="mx-2">|</span>
                    {{ 'tour.external_test.stored'|trans }}: {{ stored }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if summary %}
        <div class="mt-6 space-y-4">
            <h2 class="text-lg font-semibold">{{ 'tour.external_test.results'|trans }}</h2>
            {% for result in orderedResults %}
                <div class="rounded border border-white-light bg-white p-4 dark:border-dark-light/20 dark:bg-[#0e1726]">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <div class="font-semibold">{{ result.source.name }}</div>
                            <div class="text-xs text-white-dark">{{ result.source.domain }}</div>
                        </div>
                        <span class="badge {{ result.success and result.status.value != 'skipped' ? 'bg-info' : 'bg-danger' }} text-white">{{ ('tour.external_test.status.' ~ result.status.value)|trans }}</span>
                    </div>

                    <div class="mt-3 grid gap-3 md:grid-cols-4">
                        <div>{{ 'tour.external_test.eligibility'|trans }}: {{ ('tour.external_test.eligibility_status.' ~ result.metadata.eligibility|default('unknown'))|trans }}</div>
                        <div>{{ 'tour.external_test.strategy'|trans }}: {{ result.metadata.accessStrategy|default(result.source.provider) }}</div>
                        <div>{{ 'tour.external_test.raw'|trans }}: {{ result.metadata.rawResultCount|default(0) }}</div>
                        <div>{{ 'tour.external_test.accepted'|trans }}: {{ result.metadata.acceptedCandidateCount|default(result.candidates|length) }}</div>
                        <div>{{ 'tour.external_test.rejected'|trans }}: {{ result.metadata.rejectedCandidateCount|default(0) }}</div>
                        <div>{{ 'tour.external_test.stored'|trans }}: {{ storedBySource[result.source.id]|default(0) }}</div>
                    </div>

                    <div class="mt-3 rounded border border-white-light bg-gray-50 px-3 py-2 text-sm text-white-dark dark:border-dark-light/20 dark:bg-black">
                        {{ ('tour.external_test.result_explanation.' ~ result.status.value)|trans({
                            '%raw%': result.metadata.rawResultCount|default(0),
                            '%accepted%': result.metadata.acceptedCandidateCount|default(result.candidates|length),
                            '%rejected%': result.metadata.rejectedCandidateCount|default(0),
                            '%stored%': storedBySource[result.source.id]|default(0)
                        }) }}
                    </div>

                    {% if result.status.value == 'skipped' and result.metadata.eligibilityReasons|default([]) %}
                        <div class="mt-3 rounded border border-warning/30 bg-warning/10 px-3 py-2 text-warning">
                            {{ 'tour.external_test.skipped_reason'|trans }}: {{ result.metadata.eligibilityReasons|join(', ') }}
                        </div>
                    {% endif %}

                    {% if result.errors %}
                        <div class="mt-3 text-danger">
                            <div class="font-semibold">{{ 'tour.external_test.errors'|trans }}</div>
                            <ul class="list-disc ps-5">
                                {% for error in result.errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% set rejectedCount = result.metadata.rejectedCandidateCount|default(0) %}
                    {% if result.metadata.rawResultCount|default(0) > 0 and result.metadata.acceptedCandidateCount|default(result.candidates|length) == 0 and rejectedCount > 0 %}
                        <div class="mt-3 rounded border border-warning/30 bg-warning/10 px-3 py-2 text-warning">
                            <div class="font-semibold">{{ 'tour.external_test.rejection_reasons'|trans }}</div>
                            <ul class="mt-1 list-disc ps-5">
                                {% set reasonCounts = {} %}
                                {% for diagnostic in result.metadata.offerDiagnostics|default([]) %}
                                    {% for reason in diagnostic.reasons|default([]) %}
                                        {% set reasonCounts = reasonCounts|merge({ (reason): (reasonCounts[reason]|default(0) + 1) }) %}
                                    {% endfor %}
                                {% endfor %}
                                {% for reason, count in reasonCounts %}
                                    <li>{{ count }} {{ ('tour.external_test.rejection.' ~ reason)|trans }}</li>
                                {% else %}
                                    <li>{{ 'tour.external_test.rejection.UNKNOWN'|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {% if result.candidates %}
                        <div class="table-responsive mt-4">
                            <table class="table-hover">
                                <thead>
                                    <tr>
                                        <th>{{ 'tour.external_offer.source'|trans }}</th>
                                        <th>{{ 'tour.external_offer.title'|trans }}</th>
                                        <th>{{ 'tour.external_offer.origin'|trans }}</th>
                                        <th>{{ 'tour.external_offer.destination'|trans }}</th>
                                        <th>{{ 'tour.external_offer.dates'|trans }}</th>
                                        <th>{{ 'tour.external_offer.hotel'|trans }}</th>
                                        <th>{{ 'tour.external_offer.board'|trans }}</th>
                                        <th>{{ 'tour.external_offer.flight'|trans }}</th>
                                        <th>{{ 'tour.external_offer.agency'|trans }}</th>
                                        <th>{{ 'tour.external_offer.price'|trans }}</th>
                                        <th>{{ 'tour.external_offer.booking_link'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for candidate in result.candidates %}
                                        <tr>
                                            <td>{{ candidate.sourceName }}</td>
                                            <td>
                                                <div class="font-semibold">{{ candidate.title }}</div>
                                                <div class="text-xs text-white-dark">{{ candidate.inclusions|join(', ') ?: '-' }}</div>
                                            </td>
                                            <td>{{ candidate.originText ?: '-' }}</td>
                                            <td>{{ candidate.destinationText }}</td>
                                            <td>
                                                {% if candidate.departureDate %}
                                                    {{ candidate.departureDate|date('Y-m-d') }}{% if candidate.returnDate %} -> {{ candidate.returnDate|date('Y-m-d') }}{% endif %}
                                                {% elseif candidate.validFrom %}
                                                    {{ candidate.validFrom|date('Y-m-d') }}{% if candidate.validTo %} -> {{ candidate.validTo|date('Y-m-d') }}{% endif %}
                                                {% else %}
                                                    -
                                                {% endif %}
                                                {% if candidate.nights %}<div class="text-xs text-white-dark">{{ candidate.nights }} {{ 'tour.package.nights'|trans }}</div>{% endif %}
                                            </td>
                                            <td>{{ candidate.hotelName ?: '-' }}</td>
                                            <td>{{ candidate.boardType ?: '-' }}</td>
                                            <td>{{ candidate.flightSummary ?: '-' }}</td>
                                            <td>{{ candidate.metadata.agency|default('-') }}</td>
                                            <td>
                                                {{ candidate.totalPrice }} {{ candidate.currency }}
                                                {% if candidate.metadata.priceInterpretation|default(null) %}
                                                    <div class="text-xs text-white-dark">{{ candidate.metadata.priceInterpretation }}</div>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if candidate.bookingUrl %}
                                                    <div><a href="{{ candidate.bookingUrl }}" target="_blank" rel="noopener">{{ 'tour.external_offer.booking_link'|trans }}</a></div>
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    {% if app.environment == 'dev' %}
                        <details class="mt-4">
                            <summary class="cursor-pointer font-semibold">{{ 'tour.external_test.diagnostics'|trans }}</summary>
                            <pre class="mt-2 overflow-auto rounded bg-gray-100 p-3 text-xs ltr text-left dark:bg-black">{{ result.metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        </details>
                    {% endif %}
                </div>
            {% else %}
                <div class="rounded border border-white-light bg-white p-4 text-white-dark dark:border-dark-light/20 dark:bg-[#0e1726]">
                    {{ 'tour.external_test.no_sources'|trans }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if submitted %}
        <div class="mt-6 rounded border border-white-light bg-white p-4 dark:border-dark-light/20 dark:bg-[#0e1726]">
            <h2 class="text-lg font-semibold">{{ 'tour.external_test.stored_matching_offers'|trans }}</h2>
            {% if storedOffers is empty %}
                <div class="mt-3 text-white-dark">{{ 'tour.external_test.no_stored_matching_offers'|trans }}</div>
            {% else %}
                <div class="table-responsive mt-4">
                    <table class="table-hover">
                        <thead>
                            <tr>
                                <th>{{ 'tour.external_offer.source'|trans }}</th>
                                <th>{{ 'tour.external_offer.title'|trans }}</th>
                                <th>{{ 'tour.external_offer.origin'|trans }}</th>
                                <th>{{ 'tour.external_offer.destination'|trans }}</th>
                                <th>{{ 'tour.external_offer.dates'|trans }}</th>
                                <th>{{ 'tour.external_offer.hotel'|trans }}</th>
                                <th>{{ 'tour.external_offer.board'|trans }}</th>
                                <th>{{ 'tour.external_offer.flight'|trans }}</th>
                                <th>{{ 'tour.external_offer.agency'|trans }}</th>
                                <th>{{ 'tour.external_offer.price'|trans }}</th>
                                <th>{{ 'tour.external_offer.booking_link'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for offer in storedOffers %}
                                <tr>
                                    <td>{{ offer.searchSource.name }}</td>
                                    <td>{{ offer.title }}</td>
                                    <td>{{ offer.originText ?: '-' }}</td>
                                    <td>{{ offer.destinationText }}</td>
                                    <td>
                                        {% if offer.departureDate %}
                                            {{ offer.departureDate|date('Y-m-d') }}{% if offer.returnDate %} -> {{ offer.returnDate|date('Y-m-d') }}{% endif %}
                                        {% else %}
                                            -
                                        {% endif %}
                                        {% if offer.nights %}<div class="text-xs text-white-dark">{{ offer.nights }} {{ 'tour.package.nights'|trans }}</div>{% endif %}
                                    </td>
                                    <td>{{ offer.hotelName ?: '-' }}</td>
                                    <td>{{ offer.boardType ?: '-' }}</td>
                                    <td>{{ offer.flightSummary ?: '-' }}</td>
                                    <td>{{ offer.metadata.agency|default('-') }}</td>
                                    <td>{{ offer.totalPrice }} {{ offer.currency }}</td>
                                    <td>
                                        {% if offer.bookingUrl %}
                                            <a href="{{ offer.bookingUrl }}" target="_blank" rel="noopener">{{ 'tour.external_offer.booking_link'|trans }}</a>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if submitted and searchState == 'success' %}
        <details class="mt-6 rounded border border-white-light bg-white p-4 dark:border-dark-light/20 dark:bg-[#0e1726]">
            <summary class="cursor-pointer font-semibold">{{ 'tour.external_test.adjust_search'|trans }}</summary>
            <div class="mt-4">
                {{ block('external_test_form') }}
            </div>
        </details>
    {% else %}
        <div class="{{ submitted ? 'mt-6' : '' }}">
            {% include 'components/_card.html.twig' with { body: block('external_test_form') } %}
        </div>
    {% endif %}

    {% if submitted %}
        <script>
            (function () {
                var summary = document.getElementById('external-tour-search-summary');
                if (summary) {
                    summary.focus({ preventScroll: true });
                    summary.scrollIntoView({ block: 'start' });
                }
            })();
        </script>
    {% endif %}
{% endblock %}

{% block external_test_form %}
    {{ form_start(form, { attr: { 'data-turbo': 'false' } }) }}
        {{ form_errors(form) }}
        <div class="grid gap-4 md:grid-cols-2">
            {{ controls.lookup_field(form.originAirportId, 'tour.external_test.origin_airport', path('destination_lookup_airports'), searchRequest and searchRequest.originAirport ? searchRequest.originAirport.id : '', searchRequest and searchRequest.originAirport ? searchRequest.originAirport : '', 'tour.external_test.origin_placeholder') }}
            {{ controls.lookup_field(form.destinationCityId, 'tour.external_test.destination_city', path('destination_lookup_cities'), searchRequest ? searchRequest.destinationCity.id : '', searchRequest ? searchRequest.destinationCity : '', 'tour.external_test.destination_placeholder') }}
            {{ form_row(form.departureDate, { label: 'tour.external_test.departure_date' }) }}
            {{ form_row(form.returnDate, { label: 'tour.external_test.return_date' }) }}
            {{ form_row(form.validFrom, { label: 'tour.external_test.valid_from' }) }}
            {{ form_row(form.validTo, { label: 'tour.external_test.valid_to' }) }}
            {{ form_row(form.nights, { label: 'tour.package.nights' }) }}
            {{ form_row(form.rooms, { label: 'tour.external_test.rooms' }) }}
            {{ form_row(form.adults, { label: 'tour.package.adults' }) }}
            {{ form_row(form.children, { label: 'tour.package.children' }) }}
            {{ form_row(form.childrenAgesText, { label: 'tour.package.children_ages' }) }}
            {{ form_row(form.infants, { label: 'tour.package.infants' }) }}
            {{ form_row(form.budget, { label: 'tour.external_test.budget' }) }}
            {{ form_row(form.currency, { label: 'tour.package.currency' }) }}
        </div>
        <div class="mt-5 flex justify-end">
            {% if not submitted %}
                <span class="me-3 hidden self-center text-sm text-white-dark" data-tour-search-loading>{{ 'tour.external_test.loading'|trans }}</span>
            {% endif %}
            <button type="submit" class="btn btn-primary" data-tour-search-submit>{{ 'tour.external_test.run'|trans }}</button>
        </div>
    {{ form_end(form) }}
    <script>
        (function (script) {
            var form = script.previousElementSibling;
            if (!form || form.tagName !== 'FORM') {
                return;
            }
            form.addEventListener('submit', function () {
            var button = this.querySelector('[data-tour-search-submit]');
            var loading = this.querySelector('[data-tour-search-loading]');
            if (button) {
                button.disabled = true;
            }
            if (loading) {
                loading.classList.remove('hidden');
            }
            });
        })(document.currentScript);
    </script>
{% endblock %}
