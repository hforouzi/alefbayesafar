{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'flight.airline.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'flight.airline.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('flight_airline_new') }}" class="btn btn-primary">{{ 'flight.airline.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@Flight/admin/_table_filters.html.twig' with { table: 'airlines' } %}
    <div class="table-responsive">
        <table class="table-hover">
            <thead>
                <tr>
                    <th>{{ 'flight.airline.iata'|trans }}</th>
                    <th>{{ 'flight.airline.icao'|trans }}</th>
                    <th>{{ 'flight.airline.name'|trans }}</th>
                    <th>{{ 'flight.airline.name_fa'|trans }}</th>
                    <th>{{ 'flight.common.active'|trans }}</th>
                    <th>{{ 'flight.common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for airline in airlines %}
                    <tr>
                        <td class="font-semibold">{{ airline.iataCode ?: '-' }}</td>
                        <td>{{ airline.icaoCode ?: '-' }}</td>
                        <td>{{ airline.name }}</td>
                        <td>{{ airline.nameFa ?: '-' }}</td>
                        <td>
                            <span class="badge {{ airline.active ? 'bg-success' : 'bg-danger' }} text-white">{{ airline.active ? 'flight.common.active'|trans : 'flight.common.inactive'|trans }}</span>
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-2">
                                <a href="{{ path('flight_airline_edit', { id: airline.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'flight.common.edit'|trans }}</a>
                                <form method="post" action="{{ path('flight_airline_delete', { id: airline.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_flight_airline_' ~ airline.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'flight.common.delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="py-10 text-center text-white-dark">{{ 'flight.airline.empty'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include '@Flight/admin/_pagination.html.twig' %}
{% endblock %}
