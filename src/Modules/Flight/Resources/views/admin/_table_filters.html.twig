{% macro text_filter(name, label, value) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</span>
        <input type="text" name="{{ name }}" value="{{ value|default('') }}" class="form-input form-input-sm" autocomplete="off">
    </label>
{% endmacro %}

{% macro active_filter(value) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'flight.common.active'|trans }}</span>
        <select name="active" class="form-select form-select-sm">
            <option value="">{{ 'flight.datatable.all'|trans }}</option>
            <option value="1" {{ value|default('') == '1' ? 'selected' : '' }}>{{ 'flight.common.active'|trans }}</option>
            <option value="0" {{ value|default('') == '0' ? 'selected' : '' }}>{{ 'flight.common.inactive'|trans }}</option>
        </select>
    </label>
{% endmacro %}

{% import _self as controls %}

{% set table = table|default('') %}
{% set filters = pagination.filters %}

<form method="get" class="mb-4 rounded border border-white-light/60 p-4 dark:border-dark-light/20">
    <div class="mb-4">
        {{ controls.text_filter('q', 'flight.datatable.search'|trans, filters.q|default('')) }}
    </div>

    {% if table == 'airlines' %}
        <div class="grid gap-3 md:grid-cols-5">
            {{ controls.text_filter('name', 'flight.airline.name'|trans, filters.name|default('')) }}
            {{ controls.text_filter('nameFa', 'flight.airline.name_fa'|trans, filters.nameFa|default('')) }}
            {{ controls.text_filter('iata', 'flight.airline.iata'|trans, filters.iata|default('')) }}
            {{ controls.text_filter('icao', 'flight.airline.icao'|trans, filters.icao|default('')) }}
            {{ controls.active_filter(filters.active|default('')) }}
        </div>
    {% elseif table == 'own_flight_deals' %}
        <div class="grid gap-3 md:grid-cols-4">
            <label class="block">
                <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'flight.offer.trip_type'|trans }}</span>
                <select name="tripType" class="form-select form-select-sm">
                    <option value="">{{ 'flight.datatable.all'|trans }}</option>
                    {% for value in ['one_way', 'round_trip'] %}
                        <option value="{{ value }}" {{ filters.tripType|default('') == value ? 'selected' : '' }}>{{ ('flight.trip_type.' ~ value)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="block">
                <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'flight.offer.cabin_class'|trans }}</span>
                <select name="cabinClass" class="form-select form-select-sm">
                    <option value="">{{ 'flight.datatable.all'|trans }}</option>
                    {% for value in ['economy', 'premium_economy', 'business', 'first'] %}
                        <option value="{{ value }}" {{ filters.cabinClass|default('') == value ? 'selected' : '' }}>{{ ('flight.cabin_class.' ~ value)|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            {{ controls.active_filter(filters.active|default('')) }}
        </div>
    {% endif %}

    <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
        <label class="block">
            <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'flight.datatable.rows_per_page'|trans }}</span>
            <select name="pageSize" class="form-select form-select-sm w-28">
                {% for size in [25, 50, 100] %}
                    <option value="{{ size }}" {{ pagination.pageSize == size ? 'selected' : '' }}>{{ size }}</option>
                {% endfor %}
            </select>
        </label>

        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">{{ 'flight.datatable.filter'|trans }}</button>
            <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})) }}" class="btn btn-outline-secondary">{{ 'flight.datatable.reset_filters'|trans }}</a>
        </div>
    </div>
</form>
