{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'transfer.offer.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ product.name }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('transfer_product_edit', { id: product.id }) }}" class="btn btn-light">{{ 'transfer.offer.back_to_product'|trans }}</a>
    <a href="{{ path('transfer_offer_new', { product: product.id }) }}" class="btn btn-primary">{{ 'transfer.offer.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% if offers is empty %}
        <div class="rounded border border-white-light/60 bg-white p-10 text-center text-white-dark dark:border-dark-light/20 dark:bg-[#0e1726]">
            {{ 'transfer.offer.empty'|trans }}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table-hover">
                <thead>
                    <tr>
                        <th>{{ 'transfer.offer.date_context'|trans }}</th>
                        <th>{{ 'transfer.offer.price'|trans }}</th>
                        <th>{{ 'transfer.offer.pricing_mode'|trans }}</th>
                        <th>{{ 'transfer.offer.availability_status'|trans }}</th>
                        <th>{{ 'transfer.offer.priority'|trans }}</th>
                        <th>{{ 'transfer.offer.active'|trans }}</th>
                        <th>{{ 'transfer.common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        <tr>
                            <td>
                                {% if offer.validFrom or offer.validTo %}
                                    {{ offer.validFrom ? offer.validFrom|date('Y-m-d') : '-' }} &rarr; {{ offer.validTo ? offer.validTo|date('Y-m-d') : '-' }}
                                {% else %}
                                    {{ 'transfer.offer.always_valid'|trans }}
                                {% endif %}
                            </td>
                            <td>{{ offer.priceLabel }}</td>
                            <td>{{ ('transfer.pricing_mode.' ~ offer.pricingMode.value)|trans }}</td>
                            <td>{{ ('transfer.availability_status.' ~ offer.availabilityStatus.value)|trans }}</td>
                            <td>{{ offer.priority }}</td>
                            <td>
                                <span class="badge {{ offer.active ? 'bg-success' : 'bg-danger' }} text-white">{{ offer.active ? 'transfer.offer.active'|trans : 'transfer.offer.inactive'|trans }}</span>
                            </td>
                            <td>
                                <div class="flex flex-wrap gap-2">
                                    <a href="{{ path('transfer_offer_edit', { product: product.id, offer: offer.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'transfer.common.edit'|trans }}</a>
                                    <form method="post" action="{{ path('transfer_offer_toggle', { product: product.id, offer: offer.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_transfer_offer_' ~ offer.id) }}">
                                        <button type="submit" class="btn btn-sm {{ offer.active ? 'btn-outline-danger' : 'btn-outline-success' }}">{{ offer.active ? 'transfer.offer.deactivate'|trans : 'transfer.offer.activate'|trans }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
