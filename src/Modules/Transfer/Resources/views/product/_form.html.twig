{% macro relation_field(field, label, value, url, placeholder) %}
    <div
        class="relative"
        data-controller="geo-select"
        data-geo-select-url-value="{{ url }}"
        data-geo-select-min-length-value="2"
        data-loading-text="{{ 'transfer.lookup.loading'|trans }}"
        data-no-results-text="{{ 'transfer.lookup.no_results'|trans }}"
        data-error-text="{{ 'transfer.lookup.error'|trans }}"
    >
        <label class="mb-2 block text-sm font-medium text-black dark:text-white-light" for="{{ field.vars.id }}_search">{{ label|trans }}</label>
        <div class="flex gap-2">
            <input id="{{ field.vars.id }}_search" type="search" class="form-input" value="{{ value }}" placeholder="{{ placeholder|trans }}" data-geo-select-target="input" data-action="input->geo-select#search keydown->geo-select#keydown" autocomplete="off">
            <button type="button" class="btn btn-outline-danger shrink-0" data-action="geo-select#clear">{{ 'transfer.lookup.clear'|trans }}</button>
        </div>
        {{ form_widget(field, { attr: { 'data-geo-select-target': 'hidden' } }) }}
        <div class="mt-1 text-xs text-gray-500" data-geo-select-target="status"></div>
        <div class="absolute z-20 mt-1 hidden max-h-60 w-full overflow-auto rounded-md border border-white-light bg-white shadow-lg dark:border-dark-light/20 dark:bg-[#0e1726]" data-geo-select-target="results"></div>
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{% import _self as controls %}

{{ form_start(form, { attr: { class: 'space-y-8' } }) }}
    {{ form_errors(form) }}

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'transfer.sections.basic'|trans }}</h3>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            {% for field in [form.name, form.nameFa] %}
                <div>
                    {{ form_label(field, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
                    {{ form_widget(field) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
            <div>
                {{ form_label(form.transferType, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
                {{ form_widget(form.transferType) }}
                {{ form_errors(form.transferType) }}
            </div>
            <div>
                {{ form_label(form.vehicleType, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
                {{ form_widget(form.vehicleType) }}
                {{ form_errors(form.vehicleType) }}
            </div>
            {% for field in [form.maxPassengers, form.maxLuggage] %}
                <div>
                    {{ form_label(field, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
                    {{ form_widget(field) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'transfer.sections.origin'|trans }}</h3>
        <p class="mb-3 text-sm text-white-dark">{{ 'transfer.product.endpoint_help'|trans }}</p>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            {{ controls.relation_field(form.originAirportId, 'transfer.product.origin_airport', product.originAirport ? product.originAirport : '', path('destination_lookup_airports'), 'transfer.lookup.airport_placeholder') }}
            {{ controls.relation_field(form.originCityId, 'transfer.product.origin_city', product.originCity ? product.originCity : '', path('destination_lookup_cities'), 'transfer.lookup.city_placeholder') }}
            {{ controls.relation_field(form.originHotelId, 'transfer.product.origin_hotel', product.originHotel ? product.originHotel : '', path('transfer_lookup_hotels'), 'transfer.lookup.hotel_placeholder') }}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'transfer.sections.destination'|trans }}</h3>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            {{ controls.relation_field(form.destinationAirportId, 'transfer.product.destination_airport', product.destinationAirport ? product.destinationAirport : '', path('destination_lookup_airports'), 'transfer.lookup.airport_placeholder') }}
            {{ controls.relation_field(form.destinationCityId, 'transfer.product.destination_city', product.destinationCity ? product.destinationCity : '', path('destination_lookup_cities'), 'transfer.lookup.city_placeholder') }}
            {{ controls.relation_field(form.destinationHotelId, 'transfer.product.destination_hotel', product.destinationHotel ? product.destinationHotel : '', path('transfer_lookup_hotels'), 'transfer.lookup.hotel_placeholder') }}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'transfer.sections.descriptions'|trans }}</h3>
        <div>
            {{ form_label(form.description, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-black dark:text-white-light' } }) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-base font-semibold text-black dark:text-white-light">{{ 'transfer.sections.visibility'|trans }}</h3>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-4">
            {% for field in [form.active, form.featured, form.publicVisible] %}
                <div class="flex items-end">
                    <label class="inline-flex items-center gap-3 rounded-2xl border border-white-light/40 bg-white px-4 py-4 text-sm font-medium text-black dark:border-dark-light/20 dark:bg-[#0e1726] dark:text-white-light">
                        {{ form_widget(field) }}
                        <span>{{ field.vars.label|trans }}</span>
                    </label>
                    {{ form_errors(field) }}
                </div>
            {% endfor %}
        </div>
    </section>

    <div class="mt-6 flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary">{{ 'transfer.common.save'|trans }}</button>
        <a href="{{ path('transfer_product_index') }}" class="btn btn-light">{{ 'transfer.common.cancel'|trans }}</a>
    </div>
    {{ form_rest(form) }}
{{ form_end(form, { render_rest: false }) }}
