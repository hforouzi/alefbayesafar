{% extends 'layouts/public.html.twig' %}

{% block title %}پکیج‌های من | الفبای سفر{% endblock %}

{% block body %}
    <section class="bg-[#fffaf4]">
        <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
            <div class="rounded-md border border-[#e7ddd0] bg-white p-8 text-center shadow-xl shadow-[#b99b74]/10">
                <p class="text-sm font-extrabold text-[#0f766e]">پکیج‌های من</p>
                <h1 class="mt-3 text-3xl font-black text-[#18312f]">هنوز سفری ذخیره نکرده‌اید.</h1>
                <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-[#65716e]">
                    ذخیره پکیج و مدیریت سفرها در فازهای بعدی به دامنه برنامه‌ریز سفر متصل می‌شود. در این فاز می‌توانید جریان ساخت پکیج را کامل کنید و خلاصه ترجیحات را ببینید.
                </p>
                <a href="{{ path('public_build') }}" class="mt-8 inline-flex items-center justify-center rounded-md bg-[#0f766e] px-6 py-3 text-base font-extrabold text-white transition hover:bg-[#0b5f59]">ساخت پکیج جدید</a>
            </div>
        </div>
    </section>
{% endblock %}
