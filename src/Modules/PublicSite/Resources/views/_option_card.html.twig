{# Expects: option (TripOption), explanationText (string|null), isCheapest/isBestReviewed/isFamily/isClosestDate (bool, optional) #}
{% set primaryReview = null %}
{% for source in option.hotelRecommendationContext.sources|default([]) %}
    {% if primaryReview is null and source.reviewScore is not null %}
        {% set primaryReview = source %}
    {% endif %}
{% endfor %}
{% set hasBreakfast = option.board is not null and 'breakfast' in option.board|lower %}
{% set boardLabel = null %}
{% if option.board %}
    {% set boardLower = option.board|lower %}
    {% if hasBreakfast %}
        {% set boardLabel = 'با صبحانه' %}
    {% elseif 'half board' in boardLower or 'hb' in boardLower %}
        {% set boardLabel = 'نیم‌پانسیون' %}
    {% elseif 'full board' in boardLower or 'fb' in boardLower %}
        {% set boardLabel = 'پانسیون کامل' %}
    {% elseif 'all inclusive' in boardLower %}
        {% set boardLabel = 'همه‌چیز تمام' %}
    {% elseif 'room only' in boardLower or 'ro' in boardLower %}
        {% set boardLabel = 'بدون وعده غذایی' %}
    {% else %}
        {% set boardLabel = option.board %}
    {% endif %}
{% endif %}

<article class="rounded-xl border border-[#e7ddd0] bg-white p-4 shadow-md shadow-[#b99b74]/10 sm:p-5">
    <div class="flex flex-wrap items-center gap-1.5">
        {% if option.rank == 1 %}
            <span class="rounded-full bg-[#0f766e] px-3 py-1 text-xs font-black text-white">پیشنهاد ویژه</span>
        {% endif %}
        {% if isCheapest|default(false) %}
            <span class="rounded-full border border-[#0f766e]/40 bg-[#e0f2ef] px-3 py-1 text-xs font-extrabold text-[#0f766e]">ارزان‌تر</span>
        {% endif %}
        {% if isBestReviewed|default(false) %}
            <span class="rounded-full border border-[#d8cab9] bg-[#fffaf4] px-3 py-1 text-xs font-extrabold text-[#596461]">امتیاز بهتر هتل</span>
        {% endif %}
        {% if isFamily|default(false) %}
            <span class="rounded-full border border-[#d8cab9] bg-[#fffaf4] px-3 py-1 text-xs font-extrabold text-[#596461]">مناسب خانواده</span>
        {% endif %}
        {% if isClosestDate|default(false) %}
            <span class="rounded-full border border-[#d8cab9] bg-[#fffaf4] px-3 py-1 text-xs font-extrabold text-[#596461]">نزدیک به تاریخ شما</span>
        {% endif %}
        <span class="rounded-full border border-[#d8cab9] px-3 py-1 text-xs font-extrabold text-[#596461]">
            {{ option.sourceType == 'own' ? 'پکیج ما' : 'تور خارجی' }}
        </span>
    </div>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <h2 class="truncate text-lg font-black leading-snug text-[#18312f] sm:text-xl">{{ option.title }}</h2>
            <p class="mt-1.5 text-sm font-bold text-[#65716e]">
                {{ option.destinationCity ?? option.destinationCountry }}
                <span class="mx-1 text-[#d8cab9]">|</span>
                {{ option.departureDate|date('Y-m-d') }}{% if option.returnDate %} تا {{ option.returnDate|date('Y-m-d') }}{% endif %}
                <span class="mx-1 text-[#d8cab9]">|</span>
                {{ option.nights }} شب
            </p>
        </div>
        <div class="shrink-0 text-left">
            {% if option.totalPrice %}
                <p class="text-2xl font-black leading-none text-[#18312f] sm:text-3xl">{{ option.totalPrice }}</p>
                <p class="mt-1 text-xs font-extrabold text-[#65716e]">{{ option.currency }}</p>
            {% else %}
                <p class="text-sm font-extrabold text-[#9aa39f]">قیمت قابل مقایسه‌ای موجود نیست</p>
            {% endif %}
        </div>
    </div>

    {% if option.hotelName or option.airline or option.agency %}
        <div class="mt-4 grid min-w-0 gap-3 rounded-lg bg-[#f7f3ee] p-3 sm:grid-cols-2 sm:p-4">
            {% if option.hotelName %}
                <div>
                    <p class="text-xs font-extrabold text-[#9aa39f]">هتل</p>
                    <p class="mt-1 font-bold text-[#18312f]">
                        {{ option.hotelName }}
                        {% if option.hotelGrade %} <span class="text-[#65716e]">&middot; {{ option.hotelGrade }} ستاره</span>{% endif %}
                    </p>
                    <div class="mt-1.5 space-y-0.5 text-xs font-semibold text-[#65716e]">
                        {% if primaryReview %}
                            <p>امتیاز کاربران: <span class="font-extrabold text-[#18312f]">{{ primaryReview.reviewScore }}{% if primaryReview.reviewScoreScale %} از {{ primaryReview.reviewScoreScale }}{% endif %}</span>{% if primaryReview.reviewCount is not null %} (بر اساس {{ primaryReview.reviewCount }} نظر){% endif %}</p>
                            {% if primaryReview.source %}<p>منبع اطلاعات هتل: {{ primaryReview.source }}</p>{% endif %}
                        {% endif %}
                        {% if option.board %}<p>صبحانه: {{ hasBreakfast ? 'دارد' : 'ندارد' }}</p>{% endif %}
                    </div>
                </div>
            {% endif %}
            {% if option.airline or option.agency %}
                <div>
                    <p class="text-xs font-extrabold text-[#9aa39f]">پرواز / آژانس</p>
                    <p class="mt-1 font-bold text-[#18312f]">{{ option.airline ?? option.agency }}</p>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if explanationText %}
        <p class="mt-4 border-t border-[#e7ddd0] pt-3 text-sm leading-7 text-[#44514f]">{{ explanationText }}</p>
    {% endif %}

    {% if option.bookingUrl %}
        <a href="{{ option.bookingUrl }}" target="_blank" rel="noopener noreferrer nofollow" class="mt-4 inline-flex rounded-md border border-[#0f766e] px-4 py-2 text-sm font-extrabold text-[#0f766e] transition hover:bg-[#0f766e] hover:text-white">مشاهده منبع</a>
    {% endif %}
</article>
