{% extends 'layouts/public.html.twig' %}

{% block title %}الفبای سفر | برنامه‌ریزی سفر{% endblock %}

{% block body %}
    <section class="bg-[#fffaf4]">
        <div class="mx-auto grid min-h-[calc(100vh-72px)] max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.05fr_.95fr] lg:px-8">
            <div class="max-w-2xl">
                <p class="mb-4 inline-flex rounded-md bg-[#e0f2ef] px-3 py-1 text-sm font-extrabold text-[#0f766e]">سفرساز فارسی برای انتخاب آگاهانه</p>
                <h1 class="text-4xl font-black leading-tight text-[#18312f] sm:text-5xl lg:text-6xl">پکیج سفر خود را قدم‌به‌قدم بسازید.</h1>
                <p class="mt-6 text-lg leading-8 text-[#596461]">
                    الفبای سفر در این فاز ورودی‌های سفر، پرواز، هتل و علایق شما را در یک تجربه ساده جمع‌آوری می‌کند تا در فازهای بعدی به جست‌وجوی واقعی و پیشنهادهای قابل اتکا متصل شود.
                </p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a href="{{ path('public_build') }}" class="inline-flex items-center justify-center rounded-md bg-[#0f766e] px-6 py-3 text-base font-extrabold text-white shadow-lg shadow-[#0f766e]/20 transition hover:bg-[#0b5f59]">ساخت پکیج سفر</a>
                    <a href="{{ path('public_trips') }}" class="inline-flex items-center justify-center rounded-md border border-[#d8cab9] bg-white px-6 py-3 text-base font-extrabold text-[#18312f] transition hover:border-[#0f766e] hover:text-[#0f766e]">پکیج‌های من</a>
                </div>
            </div>

            <div class="rounded-md border border-[#e7ddd0] bg-white p-4 shadow-xl shadow-[#b99b74]/10">
                <div class="rounded-md bg-[#f7f3ee] p-4">
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-md bg-white p-4">
                            <p class="text-sm font-bold text-[#65716e]">مرحله ۱</p>
                            <p class="mt-2 text-xl font-black text-[#18312f]">سفر</p>
                        </div>
                        <div class="rounded-md bg-white p-4">
                            <p class="text-sm font-bold text-[#65716e]">مرحله ۲</p>
                            <p class="mt-2 text-xl font-black text-[#18312f]">پرواز / هتل</p>
                        </div>
                        <div class="rounded-md bg-white p-4">
                            <p class="text-sm font-bold text-[#65716e]">مرحله ۳</p>
                            <p class="mt-2 text-xl font-black text-[#18312f]">فعالیت‌ها</p>
                        </div>
                        <div class="rounded-md bg-[#18312f] p-4 text-white">
                            <p class="text-sm font-bold text-white/70">مرحله ۴</p>
                            <p class="mt-2 text-xl font-black">تأیید / نتایج</p>
                        </div>
                    </div>
                    <div class="mt-4 rounded-md border border-dashed border-[#d8cab9] bg-white p-4">
                        <p class="text-sm font-extrabold text-[#0f766e]">بدون قیمت یا موجودی ساختگی</p>
                        <p class="mt-2 text-sm leading-7 text-[#65716e]">تا زمان اتصال منابع معتبر، نتیجه نهایی فقط خلاصه ترجیحات شما را نشان می‌دهد.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-[#f7f3ee]">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-black text-[#18312f]">چه چیزهایی را می‌توانید انتخاب کنید؟</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {% for item in [
                    { title: 'پرواز', text: 'اکونومی یا بیزینس، مستقیم یا بدون ترجیح' },
                    { title: 'هتل', text: 'ستاره هتل، نوع اتاق و صبحانه' },
                    { title: 'تور و گشت', text: 'فعالیت‌های تفریحی و تعداد روزهای گشت' },
                    { title: 'خدمات جانبی', text: 'ویزا، بیمه، ترانسفر و اینترنت سفر' }
                ] %}
                    <div class="rounded-md border border-[#e7ddd0] bg-white p-5 shadow-sm">
                        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-md bg-[#e0f2ef] text-lg font-black text-[#0f766e]">{{ loop.index }}</span>
                        <h3 class="font-black text-[#18312f]">{{ item.title }}</h3>
                        <p class="mt-2 text-sm leading-7 text-[#65716e]">{{ item.text }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="bg-[#fffaf4]">
        <div class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
            <div class="grid gap-4 rounded-md bg-[#e0f2ef] p-6 md:grid-cols-3">
                {% for item in [
                    { title: 'ورودی سفر', text: 'مبدأ، مقصد، تاریخ، مسافران و بودجه را وارد می‌کنید.' },
                    { title: 'ترجیحات پکیج', text: 'پرواز، هتل، فعالیت‌ها و خدمات جانبی را مشخص می‌کنید.' },
                    { title: 'خلاصه آماده', text: 'ترجیحات آماده می‌شود؛ اتصال به قیمت و موجودی واقعی در فاز بعدی است.' }
                ] %}
                    <div>
                        <h3 class="font-black text-[#18312f]">{{ item.title }}</h3>
                        <p class="mt-2 text-sm leading-7 text-[#4b5a57]">{{ item.text }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
