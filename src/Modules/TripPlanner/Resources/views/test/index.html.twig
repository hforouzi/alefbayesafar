{% extends 'layouts/admin.html.twig' %}

{% macro lookup_field(formField, label, url, value, selectedLabel, placeholder) %}
    <div
        data-controller="geo-select"
        data-geo-select-url-value="{{ url }}"
        data-loading-text="{{ 'trip_planner.lookup.loading'|trans }}"
        data-no-results-text="{{ 'trip_planner.lookup.no_results'|trans }}"
        data-error-text="{{ 'trip_planner.lookup.error'|trans }}"
        class="relative"
    >
        <label for="{{ formField.vars.id }}_search" class="form-label">{{ label|trans }}</label>
        <div class="flex gap-2">
            <input id="{{ formField.vars.id }}_search" type="search" value="{{ selectedLabel|default('') }}" placeholder="{{ placeholder|trans }}" autocomplete="off" class="form-input" data-geo-select-target="input" data-action="input->geo-select#search keydown->geo-select#keydown">
            <button type="button" class="btn btn-outline-secondary px-3" data-action="geo-select#clear">{{ 'trip_planner.lookup.clear'|trans }}</button>
        </div>
        {{ form_widget(formField, { value: value|default(''), attr: { 'data-geo-select-target': 'hidden' } }) }}
        <div class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-auto rounded border border-white-light bg-white shadow-lg dark:border-dark-light/20 dark:bg-[#0e1726]" data-geo-select-target="results"></div>
        <div class="mt-1 min-h-4 text-xs text-danger">{{ form_errors(formField) }}</div>
        <div class="mt-1 min-h-4 text-xs text-white-dark" data-geo-select-target="status"></div>
    </div>
{% endmacro %}

{% import _self as controls %}

{% block page_title %}{{ 'trip_planner.test.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'trip_planner.test.subtitle'|trans }}{% endblock %}

{% block body %}
    {% if submitted %}
        <div id="trip-planner-summary" tabindex="-1" class="rounded border border-info/30 bg-info/10 px-4 py-3 text-info outline-none">
            <div class="font-semibold">{{ ('trip_planner.status.' ~ state|default('invalid_request'))|trans }}</div>
            {% if result %}
                <div class="mt-2 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-4">
                    <div>{{ 'trip_planner.counts.tour'|trans }}: {{ result.counts.tourOptions|default(0) }}</div>
                    <div>{{ 'trip_planner.counts.custom'|trans }}: {{ result.counts.customOptions|default(0) }}</div>
                    <div>{{ 'trip_planner.counts.complete'|trans }}: {{ result.counts.completeOptions|default(0) }}</div>
                    <div>{{ 'trip_planner.counts.partial'|trans }}: {{ result.counts.partialOptions|default(0) }}</div>
                </div>
                <ul class="mt-3 list-disc ps-5 text-sm">
                    {% for message in result.messages %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="mt-1 text-sm">{{ 'trip_planner.test.invalid_request_help'|trans }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if result %}
        <div class="mt-6 rounded border border-white-light bg-white p-4 dark:border-dark-light/20 dark:bg-[#0e1726]">
            <h2 class="text-lg font-semibold">{{ 'trip_planner.test.options'|trans }}</h2>
            {% if result.options is empty %}
                <div class="mt-3 rounded border border-warning/30 bg-warning/10 px-3 py-2 text-warning">
                    {{ 'trip_planner.test.no_options'|trans }}
                </div>
            {% else %}
                <div class="table-responsive mt-4">
                    <table class="table-hover">
                        <thead>
                            <tr>
                                <th>{{ 'trip_planner.option.rank'|trans }}</th>
                                <th>{{ 'trip_planner.option.type'|trans }}</th>
                                <th>{{ 'trip_planner.option.title'|trans }}</th>
                                <th>{{ 'trip_planner.option.price'|trans }}</th>
                                <th>{{ 'trip_planner.option.components'|trans }}</th>
                                <th>{{ 'trip_planner.option.completeness'|trans }}</th>
                                <th>{{ 'trip_planner.option.budget'|trans }}</th>
                                <th>{{ 'trip_planner.option.reasons'|trans }}</th>
                                <th>{{ 'trip_planner.option.warnings'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for option in result.options %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>
                                        <div class="font-semibold">{{ ('trip_planner.option_type.' ~ option.optionType.value)|trans }}</div>
                                        <div class="text-xs text-white-dark">{{ option.sourceName ?: option.sourceType }}</div>
                                    </td>
                                    <td>
                                        {{ option.title }}
                                        {% if option.bookingUrl %}
                                            <div><a href="{{ option.bookingUrl }}" target="_blank" rel="noopener">{{ 'trip_planner.option.booking_link'|trans }}</a></div>
                                        {% endif %}
                                    </td>
                                    <td>{% if option.totalPrice %}{{ option.totalPrice }} {{ option.currency }}{% else %}{{ 'trip_planner.option.price_unavailable'|trans }}{% endif %}</td>
                                    <td>
                                        <ul class="list-disc ps-5">
                                            {% for component in option.components %}
                                                <li>{{ component.type }}: {{ component.title }}{% if component.price %} ({{ component.price }} {{ component.currency }}){% endif %}</li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                    <td>{{ ('trip_planner.completeness.' ~ option.completenessStatus)|trans }}</td>
                                    <td>{{ ('trip_planner.budget.' ~ option.budgetStatus)|trans }}</td>
                                    <td>{{ option.reasons|join(', ') ?: '-' }}</td>
                                    <td>{{ option.warnings|join(', ') ?: '-' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if result and app.environment == 'dev' %}
        <details class="mt-6 rounded border border-white-light bg-white p-4 dark:border-dark-light/20 dark:bg-[#0e1726]">
            <summary class="cursor-pointer font-semibold">{{ 'trip_planner.test.diagnostics'|trans }}</summary>
            <pre class="mt-2 overflow-auto rounded bg-gray-100 p-3 text-xs ltr text-left dark:bg-black">{{ result.diagnostics|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </details>
    {% endif %}

    <div class="{{ submitted ? 'mt-6' : '' }}">
        {% include 'components/_card.html.twig' with { body: block('trip_planner_form') } %}
    </div>

    {% if submitted %}
        <script>
            (function () {
                var summary = document.getElementById('trip-planner-summary');
                if (summary) {
                    summary.focus({ preventScroll: true });
                    summary.scrollIntoView({ block: 'start' });
                }
            })();
        </script>
    {% endif %}
{% endblock %}

{% block trip_planner_form %}
    {{ form_start(form, { attr: { 'data-turbo': 'false' } }) }}
        {{ form_errors(form) }}
        <div class="grid gap-4 md:grid-cols-2">
            {{ controls.lookup_field(form.originAirportId, 'trip_planner.form.origin_airport', path('destination_lookup_airports'), tripRequest and tripRequest.originAirport ? tripRequest.originAirport.id : '', tripRequest and tripRequest.originAirport ? tripRequest.originAirport : '', 'trip_planner.form.origin_airport_placeholder') }}
            {{ controls.lookup_field(form.originCityId, 'trip_planner.form.origin_city', path('destination_lookup_cities'), tripRequest and tripRequest.originCity ? tripRequest.originCity.id : '', tripRequest and tripRequest.originCity ? tripRequest.originCity : '', 'trip_planner.form.origin_city_placeholder') }}
            {{ controls.lookup_field(form.destinationCityId, 'trip_planner.form.destination_city', path('destination_lookup_cities'), tripRequest ? tripRequest.destinationCity.id : '', tripRequest ? tripRequest.destinationCity : '', 'trip_planner.form.destination_city_placeholder') }}
            {{ form_row(form.departureDate, { label: 'trip_planner.form.departure_date' }) }}
            {{ form_row(form.returnDate, { label: 'trip_planner.form.return_date' }) }}
            {{ form_row(form.nights, { label: 'trip_planner.form.nights' }) }}
            {{ form_row(form.adults, { label: 'trip_planner.form.adults' }) }}
            {{ form_row(form.children, { label: 'trip_planner.form.children' }) }}
            {{ form_row(form.childrenAgesText, { label: 'trip_planner.form.children_ages' }) }}
            {{ form_row(form.infants, { label: 'trip_planner.form.infants' }) }}
            {{ form_row(form.budget, { label: 'trip_planner.form.budget' }) }}
            {{ form_row(form.preferredCurrency, { label: 'trip_planner.form.currency' }) }}
            {{ form_row(form.hotelStarPreference, { label: 'trip_planner.form.hotel_stars' }) }}
            {{ form_row(form.flightCabin, { label: 'trip_planner.form.flight_cabin' }) }}
        </div>
        <div class="mt-4 grid gap-3 md:grid-cols-3">
            <label class="inline-flex items-center gap-2">{{ form_widget(form.breakfastPreferred) }} <span>{{ 'trip_planner.form.breakfast'|trans }}</span></label>
            <label class="inline-flex items-center gap-2">{{ form_widget(form.directFlightPreferred) }} <span>{{ 'trip_planner.form.direct_flight'|trans }}</span></label>
            <label class="inline-flex items-center gap-2">{{ form_widget(form.transferRequired) }} <span>{{ 'trip_planner.form.transfer_required'|trans }}</span></label>
        </div>
        <div class="mt-4">
            {{ form_label(form.activityCategories, 'trip_planner.form.activities') }}
            <div class="mt-2 grid gap-2 md:grid-cols-3">
                {% for child in form.activityCategories %}
                    <label class="inline-flex items-center gap-2">{{ form_widget(child) }} <span>{{ child.vars.label|trans }}</span></label>
                {% endfor %}
            </div>
            {{ form_errors(form.activityCategories) }}
        </div>
        <div class="mt-5 flex justify-end">
            <span class="me-3 hidden self-center text-sm text-white-dark" data-trip-planner-loading>{{ 'trip_planner.test.loading'|trans }}</span>
            <button type="submit" class="btn btn-primary" data-trip-planner-submit>{{ 'trip_planner.test.run'|trans }}</button>
        </div>
    {{ form_end(form) }}
    <script>
        (function (script) {
            var form = script.previousElementSibling;
            if (!form || form.tagName !== 'FORM') {
                return;
            }
            form.addEventListener('submit', function () {
                var button = this.querySelector('[data-trip-planner-submit]');
                var loading = this.querySelector('[data-trip-planner-loading]');
                if (button) {
                    button.disabled = true;
                }
                if (loading) {
                    loading.classList.remove('hidden');
                }
            });
        })(document.currentScript);
    </script>
{% endblock %}
