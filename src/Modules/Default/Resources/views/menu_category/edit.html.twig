{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'menu_category.edit'|trans }}{% endblock %}
{% block page_subtitle %}{{ menuCategory.name }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('menu_category_show', { id: menuCategory.id }) }}" class="btn btn-light">
        {{ 'common.show'|trans }}
    </a>
    <a href="{{ path('menu_category_index') }}" class="btn btn-light">
        {{ 'common.back'|trans }}
    </a>
{% endblock %}

{% block body %}
    {% include '@Default/menu_category/_form.html.twig' with { menuCategory: menuCategory } %}
{% endblock %}
