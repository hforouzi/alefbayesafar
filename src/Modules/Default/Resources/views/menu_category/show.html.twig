{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'menu_category.show'|trans }}{% endblock %}
{% block page_subtitle %}{{ menuCategory.name }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('menu_category_edit', { id: menuCategory.id }) }}" class="btn btn-warning">
        {{ 'common.edit'|trans }}
    </a>
    <a href="{{ path('menu_category_index') }}" class="btn btn-light">
        {{ 'common.back'|trans }}
    </a>
{% endblock %}

{% block body %}
    <div class="panel">
        <div class="mb-5 flex items-start justify-between gap-4">
            <div>
                <h5 class="text-lg font-semibold text-black dark:text-white-light">{{ menuCategory.name }}</h5>
                <p class="mt-1 text-sm text-white-dark">{{ menuCategory.code }}</p>
            </div>
            {% include 'components/_status_badge.html.twig' with {
                status: menuCategory.active ? 'active' : 'inactive',
                label: menuCategory.active ? 'menu_category.active' : 'menu_category.inactive',
            } %}
        </div>

        {% set details %}
            <tbody>
                <tr><th>{{ 'menu_category.code'|trans }}</th><td>{{ menuCategory.code }}</td></tr>
                <tr><th>{{ 'menu_category.name'|trans }}</th><td>{{ menuCategory.name }}</td></tr>
                <tr><th>{{ 'menu_category.label_key'|trans }}</th><td>{{ menuCategory.labelKey ?: '-' }}</td></tr>
                <tr><th>{{ 'menu_category.icon'|trans }}</th><td>{{ menuCategory.icon ?: '-' }}</td></tr>
                <tr><th>{{ 'menu_category.position'|trans }}</th><td>{{ menuCategory.position }}</td></tr>
                <tr>
                    <th>{{ 'menu_category.active'|trans }}</th>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: menuCategory.active ? 'active' : 'inactive',
                            label: menuCategory.active ? 'menu_category.active' : 'menu_category.inactive',
                        } %}
                    </td>
                </tr>
                <tr><th>{{ 'common.created_at'|trans }}</th><td>{{ menuCategory.createdAt ? menuCategory.createdAt|date('Y-m-d H:i') : '-' }}</td></tr>
                <tr><th>{{ 'common.updated_at'|trans }}</th><td>{{ menuCategory.updatedAt ? menuCategory.updatedAt|date('Y-m-d H:i') : '-' }}</td></tr>
            </tbody>
        {% endset %}

        {% include 'components/_table.html.twig' with {
            body: details,
        } %}

        <div class="mt-6 flex flex-wrap items-center gap-3">
            {% include '@Default/menu_category/_delete_form.html.twig' with { menuCategory: menuCategory } %}
        </div>
    </div>
{% endblock %}
