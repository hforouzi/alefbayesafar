{% macro travel_date_field(formField, label) %}
    <div
        data-controller="locale-date"
        data-locale-date-locale-value="{{ app.request.locale|default('fa') }}"
        data-locale-date-today-text-value="{{ 'hotel.offer.date.today'|trans }}"
        data-locale-date-clear-text-value="{{ 'hotel.offer.date.clear'|trans }}"
        data-locale-date-select-date-text-value="{{ 'hotel.offer.date.select_date'|trans }}"
        data-locale-date-previous-month-text-value="{{ 'hotel.offer.date.previous_month'|trans }}"
        data-locale-date-next-month-text-value="{{ 'hotel.offer.date.next_month'|trans }}"
        data-locale-date-invalid-date-text-value="{{ 'hotel.offer.date.invalid_date'|trans }}"
    >
        <label class="form-label" for="{{ formField.vars.id }}_display">{{ label|trans }}</label>
        <div class="relative">
            <input
                id="{{ formField.vars.id }}_display"
                type="text"
                class="form-input ltr:pr-9 rtl:pl-9"
                autocomplete="off"
                placeholder="{{ 'hotel.offer.date.select_date'|trans }}"
                data-locale-date-target="display"
                data-action="focus->locale-date#open input->locale-date#typed keydown->locale-date#keydown"
            >
            <button type="button" class="absolute top-1/2 -translate-y-1/2 rounded p-1 text-white-dark hover:text-primary ltr:right-2 rtl:left-2" data-action="locale-date#toggle" aria-label="{{ 'hotel.offer.date.select_date'|trans }}">
                <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg>
            </button>
        </div>
        {{ form_widget(formField) }}
        <div class="mt-1 min-h-4 text-xs text-danger">{{ form_errors(formField) }}</div>
        <div class="mt-1 min-h-4 text-xs text-danger" data-locale-date-target="status"></div>
    </div>
{% endmacro %}

{{ form_start(form) }}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4" data-controller="child-ages">
        {{ form_row(form.roomType) }}
        {{ _self.travel_date_field(form.validFrom, 'hotel.rate.valid_from') }}
        {{ _self.travel_date_field(form.validTo, 'hotel.rate.valid_to') }}
        {{ form_row(form.adults) }}
        {{ form_row(form.children) }}
        <div data-child-ages-target="row">{{ form_row(form.childrenAges) }}</div>
        {{ form_row(form.boardType) }}
        {{ form_row(form.currency) }}
        {{ form_row(form.pricePerNight) }}
        {{ form_row(form.priority) }}
        <div class="xl:col-span-4">{{ form_row(form.active) }}</div>
    </div>
    <div class="mt-5 flex justify-end gap-2">
        <a href="{{ path('hotel_rate_index', { hotel: hotel.id }) }}" class="btn btn-outline-secondary">{{ 'hotel.rate.back_to_list'|trans }}</a>
        <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
    </div>
{{ form_end(form) }}
