{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'hotel.amenity.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'hotel.amenity.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('hotel_amenity_new') }}" class="btn btn-primary">{{ 'hotel.amenity.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@Hotel/admin/_table_filters.html.twig' with { table: 'amenities' } %}

    {% set table_body %}
        <thead>
            <tr>
                <th>{{ 'hotel.amenity.name'|trans }}</th>
                <th>{{ 'hotel.amenity.name_fa'|trans }}</th>
                <th>{{ 'hotel.amenity.code'|trans }}</th>
                <th>{{ 'hotel.common.active'|trans }}</th>
                <th class="text-right">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for amenity in amenities %}
                <tr>
                    <td class="font-semibold text-black dark:text-white-light">{{ amenity.name }}</td>
                    <td>{{ amenity.nameFa ?: '-' }}</td>
                    <td class="whitespace-nowrap">{{ amenity.code }}</td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: amenity.active ? 'active' : 'inactive',
                            label: amenity.active ? 'hotel.common.active' : 'hotel.common.inactive',
                        } %}
                    </td>
                    <td class="whitespace-nowrap text-right">
                        <div class="flex flex-wrap justify-end gap-2">
                            <a href="{{ path('hotel_amenity_edit', { id: amenity.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('hotel_amenity_delete', { id: amenity.id }) }}" onsubmit="return confirm('{{ 'hotel.common.delete_confirmation'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_hotel_amenity_' ~ amenity.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="py-10 text-center text-white-dark"><div>{{ 'hotel.datatable.no_results'|trans }}</div><a href="{{ path('hotel_amenity_index') }}" class="mt-3 inline-flex text-primary hover:underline">{{ 'hotel.datatable.reset_filters'|trans }}</a></td></tr>
            {% endfor %}
        </tbody>
    {% endset %}
    {% include 'components/_card.html.twig' with { body: include('components/_table.html.twig', { body: table_body }) } %}
    {% include '@Hotel/admin/_pagination.html.twig' %}
{% endblock %}
