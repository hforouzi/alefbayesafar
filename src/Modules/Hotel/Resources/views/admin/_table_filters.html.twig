{% macro text_filter(name, label, value, type) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</span>
        <input type="{{ type|default('text') }}" name="{{ name }}" value="{{ value|default('') }}" class="form-input form-input-sm" autocomplete="off">
    </label>
{% endmacro %}

{% macro boolean_filter(name, label, value) %}
    <label class="block">
        <span class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</span>
        <select name="{{ name }}" class="form-select form-select-sm">
            <option value="">{{ 'hotel.datatable.all'|trans }}</option>
            <option value="1" {{ value|default('') == '1' ? 'selected' : '' }}>{{ 'hotel.common.yes'|trans }}</option>
            <option value="0" {{ value|default('') == '0' ? 'selected' : '' }}>{{ 'hotel.common.no'|trans }}</option>
        </select>
    </label>
{% endmacro %}

{% macro relation_filter(name, id, label, url, value, selectedLabel, dependsCity) %}
    <div
        data-controller="geo-select"
        data-geo-select-url-value="{{ url }}"
        {% if dependsCity %}data-geo-select-depends-city-value="{{ dependsCity }}"{% endif %}
        data-loading-text="{{ 'hotel.lookup.loading'|trans }}"
        data-no-results-text="{{ 'hotel.lookup.no_results'|trans }}"
        data-error-text="{{ 'hotel.lookup.error'|trans }}"
        class="relative"
    >
        <label for="{{ id }}_search" class="mb-1 block text-xs font-semibold text-white-dark">{{ label }}</label>
        <div class="flex gap-2">
            <input id="{{ id }}_search" type="search" value="{{ selectedLabel|default('') }}" autocomplete="off" class="form-input form-input-sm" data-geo-select-target="input" data-action="input->geo-select#search keydown->geo-select#keydown">
            <button type="button" class="btn btn-sm btn-outline-secondary px-2" data-action="geo-select#clear">{{ 'hotel.lookup.clear'|trans }}</button>
        </div>
        <input id="{{ id }}" name="{{ name }}" value="{{ value|default('') }}" type="hidden" data-geo-select-target="hidden">
        <div class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-auto rounded border border-white-light bg-white shadow-lg dark:border-dark-light/20 dark:bg-[#0e1726]" data-geo-select-target="results"></div>
        <div class="mt-1 min-h-4 text-xs text-white-dark" data-geo-select-target="status"></div>
    </div>
{% endmacro %}

{% import _self as controls %}
{% set table = table|default('hotels') %}
{% set filters = pagination.filters %}
{% set filterLabels = filterLabels|default({}) %}

<form method="get" class="mb-4 rounded border border-white-light/60 p-4 dark:border-dark-light/20">
    <div class="mb-4">
        {{ controls.text_filter('q', 'hotel.datatable.search'|trans, filters.q|default('')) }}
    </div>

    {% if table == 'hotels' %}
        <div class="grid gap-3 md:grid-cols-4 xl:grid-cols-7">
            {{ controls.text_filter('name', 'hotel.datatable.columns.name'|trans, filters.name|default('')) }}
            {{ controls.text_filter('nameFa', 'hotel.datatable.columns.name_fa'|trans, filters.nameFa|default('')) }}
            {{ controls.relation_filter('city', 'filter_city', 'hotel.datatable.columns.city'|trans, path('destination_lookup_cities'), filters.city|default(''), filterLabels.city|default(''), null) }}
            {{ controls.relation_filter('district', 'filter_district', 'hotel.datatable.columns.district'|trans, path('destination_lookup_districts'), filters.district|default(''), filterLabels.district|default(''), '#filter_city') }}
            <label class="block">
                <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'hotel.datatable.columns.stars'|trans }}</span>
                <select name="stars" class="form-select form-select-sm">
                    <option value="">{{ 'hotel.datatable.all'|trans }}</option>
                    {% for star in 1..5 %}
                        <option value="{{ star }}" {{ filters.stars|default('') == star ? 'selected' : '' }}>{{ 'hotel.hotel.stars_value'|trans({ '%stars%': star }) }}</option>
                    {% endfor %}
                </select>
            </label>
            {{ controls.boolean_filter('active', 'hotel.datatable.columns.active'|trans, filters.active|default('')) }}
            {{ controls.boolean_filter('verified', 'hotel.datatable.columns.verified'|trans, filters.verified|default('')) }}
        </div>
    {% elseif table == 'amenities' %}
        <div class="grid gap-3 md:grid-cols-4">
            {{ controls.text_filter('name', 'hotel.datatable.columns.name'|trans, filters.name|default('')) }}
            {{ controls.text_filter('nameFa', 'hotel.datatable.columns.name_fa'|trans, filters.nameFa|default('')) }}
            {{ controls.text_filter('code', 'hotel.datatable.columns.code'|trans, filters.code|default('')) }}
            {{ controls.boolean_filter('active', 'hotel.datatable.columns.active'|trans, filters.active|default('')) }}
        </div>
    {% endif %}

    <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
        <label class="block">
            <span class="mb-1 block text-xs font-semibold text-white-dark">{{ 'hotel.datatable.rows_per_page'|trans }}</span>
            <select name="pageSize" class="form-select form-select-sm w-28">
                {% for size in [25, 50, 100] %}
                    <option value="{{ size }}" {{ pagination.pageSize == size ? 'selected' : '' }}>{{ size }}</option>
                {% endfor %}
            </select>
        </label>

        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">{{ 'hotel.datatable.filter'|trans }}</button>
            <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})) }}" class="btn btn-outline-secondary">{{ 'hotel.datatable.reset_filters'|trans }}</a>
        </div>
    </div>
</form>
