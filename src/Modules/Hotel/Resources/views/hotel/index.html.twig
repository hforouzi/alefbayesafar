{% extends 'layouts/admin.html.twig' %}

{% block page_title %}{{ 'hotel.hotel.title'|trans }}{% endblock %}
{% block page_subtitle %}{{ 'hotel.hotel.subtitle'|trans }}{% endblock %}
{% block page_actions %}
    <a href="{{ path('hotel_new') }}" class="btn btn-primary">{{ 'hotel.hotel.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@Hotel/admin/_table_filters.html.twig' with { table: 'hotels' } %}

    {% set table_body %}
        <thead>
            <tr>
                <th>{{ 'hotel.hotel.name'|trans }}</th>
                <th>{{ 'hotel.image.primary'|trans }}</th>
                <th>{{ 'hotel.hotel.name_fa'|trans }}</th>
                <th>{{ 'hotel.hotel.city'|trans }}</th>
                <th>{{ 'hotel.hotel.district'|trans }}</th>
                <th>{{ 'hotel.hotel.stars'|trans }}</th>
                <th>{{ 'hotel.common.active'|trans }}</th>
                <th>{{ 'hotel.common.verified'|trans }}</th>
                <th>{{ 'hotel.hotel.updated'|trans }}</th>
                <th class="text-right">{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for hotel in hotels %}
                <tr>
                    <td class="font-semibold text-black dark:text-white-light">
                        <a href="{{ path('hotel_show', { id: hotel.id }) }}" class="hover:text-primary">{{ hotel.name }}</a>
                    </td>
                    <td>
                        {% set primaryImage = hotel.images|first %}
                        {% if primaryImage %}
                            {% set isRemote = primaryImage.path starts with 'http://' or primaryImage.path starts with 'https://' %}
                            {% set imageSrc = isRemote ? primaryImage.path : asset(primaryImage.path starts with '/' ? primaryImage.path|slice(1) : primaryImage.path) %}
                            <img src="{{ imageSrc }}" alt="{{ primaryImage.altFa ?: primaryImage.alt ?: hotel.name }}" class="h-12 w-16 rounded object-cover">
                        {% else %}
                            <span class="text-white-dark">-</span>
                        {% endif %}
                    </td>
                    <td>{{ hotel.nameFa ?: '-' }}</td>
                    <td>{{ hotel.city }}</td>
                    <td>{{ hotel.district ?: '-' }}</td>
                    <td>{{ hotel.stars ? 'hotel.hotel.stars_value'|trans({ '%stars%': hotel.stars }) : 'hotel.hotel.unrated'|trans }}</td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: hotel.active ? 'active' : 'inactive',
                            label: hotel.active ? 'hotel.common.active' : 'hotel.common.inactive',
                        } %}
                    </td>
                    <td>
                        {% include 'components/_status_badge.html.twig' with {
                            status: hotel.verified ? 'active' : 'inactive',
                            label: hotel.verified ? 'hotel.common.verified' : 'hotel.common.unverified',
                        } %}
                    </td>
                    <td class="whitespace-nowrap">{{ hotel.updatedAt ? hotel.updatedAt|locale_datetime : '-' }}</td>
                    <td class="whitespace-nowrap text-right">
                        <div class="flex flex-wrap justify-end gap-2">
                            <a href="{{ path('hotel_show', { id: hotel.id }) }}" class="btn btn-sm btn-outline-secondary">{{ 'common.show'|trans }}</a>
                            <a href="{{ path('hotel_edit', { id: hotel.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('hotel_delete', { id: hotel.id }) }}" onsubmit="return confirm('{{ 'hotel.common.delete_confirmation'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_hotel_' ~ hotel.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="10" class="py-10 text-center text-white-dark"><div>{{ 'hotel.datatable.no_results'|trans }}</div><a href="{{ path('hotel_index') }}" class="mt-3 inline-flex text-primary hover:underline">{{ 'hotel.datatable.reset_filters'|trans }}</a></td></tr>
            {% endfor %}
        </tbody>
    {% endset %}
    {% include 'components/_card.html.twig' with { body: include('components/_table.html.twig', { body: table_body }) } %}
    {% include '@Hotel/admin/_pagination.html.twig' %}
{% endblock %}
